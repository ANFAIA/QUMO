{
  "name": "cpu_only",
  "description": "No (supported) GPU: QUMO CPU vs Qiskit Aer CPU, compiler and QEC subsets, CPU test suite.",
  "hardware": {
    "vendor": "none"
  },
  "memory_fraction": 0.6,
  "gpu_precisions": [
    "fp32"
  ],
  "gpu_precisions_note": "GPU engines (QUMO GPU, CUDA-Q, Aer GPU, Lightning GPU, QUMO probe) run in these precisions; fp32 by default, CUDA-Q's and QUMO's default. Add fp64 with run_benchmarks.py --fp64 or [\"fp32\", \"fp64\"] here. CPU references keep their own precisions (precisions_cpu).",
  "suites": {
    "gpu_check": {
      "enabled": false,
      "targets": [
        "host"
      ],
      "timeout_s": 2400
    },
    "sv_cpu": {
      "enabled": true,
      "families": [
        "layered",
        "qft",
        "random"
      ],
      "qubits": [
        16,
        26
      ],
      "reps": 3,
      "timeout_s": 2400,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "reps": 1,
        "families": [
          "layered"
        ]
      }
    },
    "sv_gpu": {
      "enabled": false,
      "qubits_fp32": [
        16,
        16
      ],
      "qubits_fp64": [
        16,
        16
      ],
      "reps": 3,
      "timeout_s": 3600,
      "build_timeout_s": 2400,
      "quick": {
        "qubits_fp32": [
          16,
          20
        ],
        "qubits_fp64": [
          16,
          20
        ],
        "reps": 1
      },
      "cpu_max": 26
    },
    "sv_gpu_probe": {
      "enabled": false,
      "qubits": [
        24,
        26
      ],
      "reps": 3,
      "args": [],
      "timeout_s": 1800,
      "build_timeout_s": 2400,
      "quick": {
        "qubits": [
          18,
          20
        ],
        "reps": 1
      }
    },
    "baseline_aer": {
      "enabled": true,
      "devices": [
        "cpu"
      ],
      "precisions_cpu": [
        "fp64"
      ],
      "families_cpu": [
        "layered",
        "qft",
        "random"
      ],
      "qubits": [
        16,
        26
      ],
      "qubits_gpu": [
        16,
        16
      ],
      "reps": 3,
      "timeout_s": 3600,
      "python": null,
      "gpu_python": null,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "qubits_gpu": [
          16,
          20
        ],
        "reps": 1,
        "families_cpu": [
          "layered"
        ]
      }
    },
    "baseline_cudaq": {
      "enabled": false,
      "qubits_fp32": [
        16,
        16
      ],
      "qubits_fp64": [
        16,
        16
      ],
      "reps": 3,
      "cpu": false,
      "qubits_cpu": [
        16,
        22
      ],
      "timeout_s": 3600,
      "python": null,
      "quick": {
        "qubits_fp32": [
          16,
          20
        ],
        "qubits_fp64": [
          16,
          20
        ],
        "reps": 1
      }
    },
    "baseline_lightning": {
      "enabled": true,
      "devices": [
        "lightning.qubit"
      ],
      "precisions_cpu": [
        "fp64"
      ],
      "qubits": [
        16,
        26
      ],
      "qubits_gpu": [
        16,
        16
      ],
      "reps": 3,
      "timeout_s": 3600,
      "python": null,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "qubits_gpu": [
          16,
          20
        ],
        "reps": 1
      }
    },
    "neutral": {
      "enabled": true,
      "sdks": [
        "qumo",
        "qiskit",
        "tket"
      ],
      "targets": [
        "sc_grid",
        "ion_all_to_all",
        "neutral_atom"
      ],
      "levels": [
        "default"
      ],
      "filter": "qb_small__",
      "max_qubits": 6,
      "job_timeout_s": 120,
      "timeout_s": 1800,
      "python": null,
      "quick": {
        "targets": [
          "sc_grid"
        ],
        "max_qubits": 4
      }
    },
    "qec": {
      "enabled": true,
      "args": [
        "--part",
        "A",
        "--shots",
        "20000"
      ],
      "timeout_s": 2400,
      "python": null,
      "quick": {
        "args": [
          "--part",
          "A",
          "--shots",
          "2000"
        ]
      }
    },
    "tests": {
      "enabled": true,
      "targets": [
        "test"
      ],
      "timeout_s": 3600,
      "quick": {
        "targets": [
          "test"
        ],
        "files": [
          "tests/test_json.mojo"
        ]
      }
    }
  }
}
