{
  "name": "colab_t4",
  "description": "Google Colab NVIDIA T4 (Turing sm_75, 16 GB; fp64 at 1/32 rate). Free tier, ~2 vCPU, 12.7 GB RAM.",
  "hardware": {
    "vendor": "nvidia",
    "gpu": "Tesla T4",
    "arch": "sm_75",
    "memory_gib": 15,
    "colab_runtime": "T4 GPU",
    "host_ram_gib": "12.7 (51 with High-RAM)"
  },
  "memory_fraction": 0.6,
  "suites": {
    "gpu_check": {
      "enabled": true,
      "targets": [
        "host"
      ],
      "timeout_s": 2400
    },
    "sv_cpu": {
      "enabled": true,
      "families": [
        "layered"
      ],
      "qubits": [
        16,
        26
      ],
      "reps": 3,
      "timeout_s": 2400,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "reps": 1,
        "families": [
          "layered"
        ]
      }
    },
    "sv_gpu": {
      "enabled": true,
      "precisions": [
        "fp32",
        "fp64"
      ],
      "qubits_fp32": [
        16,
        30
      ],
      "qubits_fp64": [
        16,
        28
      ],
      "reps": 3,
      "timeout_s": 3600,
      "build_timeout_s": 2400,
      "quick": {
        "qubits_fp32": [
          16,
          20
        ],
        "qubits_fp64": [
          16,
          20
        ],
        "reps": 1
      },
      "cpu_max": 26,
      "variants": [
        {
          "label": "REG_BITS=4",
          "defines": [
            "QUMO_GPU_REG_BITS=4"
          ],
          "precisions": [
            "fp32"
          ],
          "note": "diagnostic A/B of 16 amplitudes per thread (GPU plan step 3); default stays REG_BITS=3"
        },
        {
          "label": "LOW_BITS=4",
          "env": {
            "QUMO_GPU_LOW_BITS": "4"
          },
          "enabled": false,
          "note": "needs the runtime knob of GPU plan step 4; without it this series would duplicate the default"
        },
        {
          "label": "LOW_BITS=3",
          "env": {
            "QUMO_GPU_LOW_BITS": "3"
          },
          "enabled": false,
          "note": "needs the runtime knob of GPU plan step 4; without it this series would duplicate the default"
        }
      ]
    },
    "sv_gpu_probe": {
      "enabled": true,
      "precisions": [
        "fp32",
        "fp64"
      ],
      "qubits": [
        24,
        26
      ],
      "reps": 3,
      "args": [],
      "timeout_s": 1800,
      "build_timeout_s": 2400,
      "quick": {
        "qubits": [
          18,
          20
        ],
        "reps": 1
      }
    },
    "baseline_aer": {
      "enabled": true,
      "devices": [
        "cpu",
        "gpu"
      ],
      "precisions_cpu": [
        "fp64",
        "fp32"
      ],
      "precisions_gpu": [
        "fp32",
        "fp64"
      ],
      "qubits": [
        16,
        26
      ],
      "qubits_gpu": [
        16,
        30
      ],
      "qubits_gpu_fp64": [
        16,
        28
      ],
      "reps": 3,
      "timeout_s": 3600,
      "python": null,
      "gpu_python": null,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "qubits_gpu": [
          16,
          20
        ],
        "reps": 1
      },
      "variants": [
        {
          "label": "fusion<=2q",
          "options": {
            "fusion_max_qubit": 2
          },
          "devices": [
            "gpu"
          ],
          "qubits": [
            20,
            40
          ],
          "note": "diagnostic: narrower Aer fusion"
        },
        {
          "label": "cuStateVec",
          "options": {
            "cuStateVec_enable": true
          },
          "devices": [
            "gpu"
          ],
          "qubits": [
            20,
            40
          ],
          "note": "diagnostic: Aer on cuStateVec (records a variant problem if this qiskit-aer-gpu build lacks it)"
        }
      ]
    },
    "baseline_cudaq": {
      "enabled": true,
      "precisions": [
        "fp32",
        "fp64"
      ],
      "qubits_fp32": [
        16,
        30
      ],
      "qubits_fp64": [
        16,
        28
      ],
      "reps": 3,
      "cpu": false,
      "qubits_cpu": [
        16,
        22
      ],
      "timeout_s": 3600,
      "python": null,
      "quick": {
        "qubits_fp32": [
          16,
          20
        ],
        "qubits_fp64": [
          16,
          20
        ],
        "reps": 1
      },
      "variants": [
        {
          "label": "no fusion",
          "env": {
            "CUDAQ_FUSION_MAX_QUBITS": "0",
            "CUDAQ_FUSION_DIAGONAL_GATE_MAX_QUBITS": "0"
          },
          "qubits": [
            20,
            40
          ],
          "note": "diagnostic: one cuStateVec call per gate (unfused execution model); the default series stays primary"
        },
        {
          "label": "fusion<=2q",
          "env": {
            "CUDAQ_FUSION_MAX_QUBITS": "2"
          },
          "qubits": [
            24,
            26
          ],
          "note": "diagnostic: dense fusion width sweep (tests the ~40-45 sweeps inferred from the T4 timings)"
        },
        {
          "label": "fusion<=3q",
          "env": {
            "CUDAQ_FUSION_MAX_QUBITS": "3"
          },
          "qubits": [
            24,
            26
          ],
          "note": "diagnostic: dense fusion width sweep (tests the ~40-45 sweeps inferred from the T4 timings)"
        },
        {
          "label": "fusion<=4q",
          "env": {
            "CUDAQ_FUSION_MAX_QUBITS": "4"
          },
          "qubits": [
            24,
            26
          ],
          "note": "diagnostic: dense fusion width sweep (tests the ~40-45 sweeps inferred from the T4 timings)"
        },
        {
          "label": "fusion<=5q",
          "env": {
            "CUDAQ_FUSION_MAX_QUBITS": "5"
          },
          "qubits": [
            24,
            26
          ],
          "note": "diagnostic: dense fusion width sweep (tests the ~40-45 sweeps inferred from the T4 timings)"
        },
        {
          "label": "fusion<=6q",
          "env": {
            "CUDAQ_FUSION_MAX_QUBITS": "6"
          },
          "qubits": [
            24,
            26
          ],
          "note": "diagnostic: dense fusion width sweep (tests the ~40-45 sweeps inferred from the T4 timings)"
        }
      ]
    },
    "baseline_lightning": {
      "enabled": true,
      "devices": [
        "lightning.gpu"
      ],
      "precisions_cpu": [
        "fp64"
      ],
      "precisions_gpu": [
        "fp32",
        "fp64"
      ],
      "qubits": [
        16,
        26
      ],
      "qubits_gpu": [
        16,
        30
      ],
      "qubits_gpu_fp64": [
        16,
        28
      ],
      "reps": 3,
      "timeout_s": 3600,
      "python": null,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "qubits_gpu": [
          16,
          20
        ],
        "reps": 1
      }
    },
    "neutral": {
      "enabled": true,
      "sdks": [
        "qumo",
        "qiskit",
        "tket"
      ],
      "targets": [
        "sc_grid",
        "ion_all_to_all",
        "neutral_atom"
      ],
      "levels": [
        "default"
      ],
      "filter": "qb_small__",
      "max_qubits": 6,
      "job_timeout_s": 120,
      "timeout_s": 1800,
      "python": null,
      "quick": {
        "targets": [
          "sc_grid"
        ],
        "max_qubits": 4
      }
    },
    "qec": {
      "enabled": false,
      "args": [
        "--part",
        "A",
        "--shots",
        "20000"
      ],
      "timeout_s": 2400,
      "python": null,
      "quick": {
        "args": [
          "--part",
          "A",
          "--shots",
          "2000"
        ]
      }
    },
    "tests": {
      "enabled": true,
      "targets": [
        "test-gpu"
      ],
      "timeout_s": 3600,
      "quick": {
        "targets": [
          "test"
        ],
        "files": [
          "tests/test_json.mojo"
        ]
      }
    }
  }
}
