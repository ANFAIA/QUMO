{
  "name": "apple_metal",
  "description": "Apple silicon GPU through Metal (fp32 only; unified memory). Local comparison point for the cloud runs.",
  "hardware": {
    "vendor": "apple",
    "gpu": "Apple M-series",
    "arch": "metal:4",
    "memory_gib": "75% of RAM (unified)"
  },
  "memory_fraction": 0.6,
  "suites": {
    "gpu_check": {
      "enabled": true,
      "targets": [
        "host"
      ],
      "timeout_s": 2400
    },
    "sv_cpu": {
      "enabled": true,
      "families": [
        "layered"
      ],
      "qubits": [
        16,
        26
      ],
      "reps": 3,
      "timeout_s": 2400,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "reps": 1,
        "families": [
          "layered"
        ]
      }
    },
    "sv_gpu": {
      "enabled": true,
      "precisions": [
        "fp32"
      ],
      "qubits_fp32": [
        16,
        28
      ],
      "qubits_fp64": [
        16,
        16
      ],
      "reps": 3,
      "timeout_s": 3600,
      "build_timeout_s": 2400,
      "quick": {
        "qubits_fp32": [
          16,
          20
        ],
        "qubits_fp64": [
          16,
          20
        ],
        "reps": 1
      },
      "cpu_max": 26
    },
    "sv_gpu_probe": {
      "enabled": false,
      "precisions": [
        "fp32"
      ],
      "qubits": [
        24,
        26
      ],
      "reps": 3,
      "args": [],
      "timeout_s": 1800,
      "build_timeout_s": 2400,
      "quick": {
        "qubits": [
          18,
          20
        ],
        "reps": 1
      }
    },
    "baseline_aer": {
      "enabled": true,
      "devices": [
        "cpu"
      ],
      "precisions_cpu": [
        "fp64",
        "fp32"
      ],
      "precisions_gpu": [
        "fp32",
        "fp64"
      ],
      "qubits": [
        16,
        26
      ],
      "qubits_gpu": [
        16,
        16
      ],
      "reps": 3,
      "timeout_s": 3600,
      "python": null,
      "gpu_python": null,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "qubits_gpu": [
          16,
          20
        ],
        "reps": 1
      }
    },
    "baseline_cudaq": {
      "enabled": false,
      "precisions": [
        "fp32",
        "fp64"
      ],
      "qubits_fp32": [
        16,
        16
      ],
      "qubits_fp64": [
        16,
        16
      ],
      "reps": 3,
      "cpu": false,
      "qubits_cpu": [
        16,
        22
      ],
      "timeout_s": 3600,
      "python": null,
      "quick": {
        "qubits_fp32": [
          16,
          20
        ],
        "qubits_fp64": [
          16,
          20
        ],
        "reps": 1
      }
    },
    "baseline_lightning": {
      "enabled": true,
      "devices": [
        "lightning.qubit"
      ],
      "precisions_cpu": [
        "fp64"
      ],
      "precisions_gpu": [
        "fp32",
        "fp64"
      ],
      "qubits": [
        16,
        26
      ],
      "qubits_gpu": [
        16,
        16
      ],
      "reps": 3,
      "timeout_s": 3600,
      "python": null,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "qubits_gpu": [
          16,
          20
        ],
        "reps": 1
      }
    },
    "neutral": {
      "enabled": true,
      "sdks": [
        "qumo",
        "qiskit",
        "tket"
      ],
      "targets": [
        "sc_grid",
        "ion_all_to_all",
        "neutral_atom"
      ],
      "levels": [
        "default"
      ],
      "filter": "qb_small__",
      "max_qubits": 6,
      "job_timeout_s": 120,
      "timeout_s": 1800,
      "python": null,
      "quick": {
        "targets": [
          "sc_grid"
        ],
        "max_qubits": 4
      }
    },
    "qec": {
      "enabled": false,
      "args": [
        "--part",
        "A",
        "--shots",
        "20000"
      ],
      "timeout_s": 2400,
      "python": null,
      "quick": {
        "args": [
          "--part",
          "A",
          "--shots",
          "2000"
        ]
      }
    },
    "tests": {
      "enabled": true,
      "targets": [
        "test-gpu"
      ],
      "timeout_s": 3600,
      "quick": {
        "targets": [
          "test"
        ],
        "files": [
          "tests/test_json.mojo"
        ]
      }
    }
  }
}
