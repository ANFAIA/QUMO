{
  "name": "colab_h100",
  "description": "Google Colab NVIDIA H100 80 GB (Hopper sm_90). Also used for B100/B200/GH200-class GPUs.",
  "hardware": {
    "vendor": "nvidia",
    "gpu": "NVIDIA H100 80GB HBM3",
    "arch": "sm_90",
    "memory_gib": 79.6,
    "colab_runtime": "H100 GPU",
    "host_ram_gib": ">= 80"
  },
  "memory_fraction": 0.6,
  "suites": {
    "gpu_check": {
      "enabled": true,
      "targets": [
        "host"
      ],
      "timeout_s": 2400
    },
    "sv_cpu": {
      "enabled": true,
      "families": [
        "layered",
        "qft",
        "random"
      ],
      "qubits": [
        16,
        28
      ],
      "reps": 3,
      "timeout_s": 2400,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "reps": 1,
        "families": [
          "layered"
        ]
      }
    },
    "sv_gpu": {
      "enabled": true,
      "precisions": [
        "fp32",
        "fp64"
      ],
      "qubits_fp32": [
        16,
        32
      ],
      "qubits_fp64": [
        16,
        30
      ],
      "reps": 3,
      "timeout_s": 7200,
      "build_timeout_s": 2400,
      "quick": {
        "qubits_fp32": [
          16,
          20
        ],
        "qubits_fp64": [
          16,
          20
        ],
        "reps": 1
      },
      "cpu_max": 28
    },
    "sv_gpu_probe": {
      "enabled": false,
      "precisions": [
        "fp32",
        "fp64"
      ],
      "qubits": [
        24,
        26
      ],
      "reps": 3,
      "args": [],
      "timeout_s": 1800,
      "build_timeout_s": 2400,
      "quick": {
        "qubits": [
          18,
          20
        ],
        "reps": 1
      }
    },
    "baseline_aer": {
      "enabled": true,
      "devices": [
        "cpu",
        "gpu"
      ],
      "precisions_cpu": [
        "fp64",
        "fp32"
      ],
      "precisions_gpu": [
        "fp32",
        "fp64"
      ],
      "families_cpu": [
        "layered",
        "qft",
        "random"
      ],
      "qubits": [
        16,
        28
      ],
      "qubits_gpu": [
        16,
        32
      ],
      "qubits_gpu_fp64": [
        16,
        30
      ],
      "reps": 3,
      "timeout_s": 3600,
      "python": null,
      "gpu_python": null,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "qubits_gpu": [
          16,
          20
        ],
        "reps": 1,
        "families_cpu": [
          "layered"
        ]
      },
      "variants": [
        {
          "label": "fusion<=2q",
          "options": {
            "fusion_max_qubit": 2
          },
          "devices": [
            "gpu"
          ],
          "qubits": [
            20,
            40
          ],
          "note": "diagnostic: narrower Aer fusion"
        },
        {
          "label": "cuStateVec",
          "options": {
            "cuStateVec_enable": true
          },
          "devices": [
            "gpu"
          ],
          "qubits": [
            20,
            40
          ],
          "note": "diagnostic: Aer on cuStateVec (records a variant problem if this qiskit-aer-gpu build lacks it)"
        }
      ]
    },
    "baseline_cudaq": {
      "enabled": true,
      "precisions": [
        "fp32",
        "fp64"
      ],
      "qubits_fp32": [
        16,
        32
      ],
      "qubits_fp64": [
        16,
        30
      ],
      "reps": 3,
      "cpu": false,
      "qubits_cpu": [
        16,
        22
      ],
      "timeout_s": 3600,
      "python": null,
      "quick": {
        "qubits_fp32": [
          16,
          20
        ],
        "qubits_fp64": [
          16,
          20
        ],
        "reps": 1
      },
      "variants": [
        {
          "label": "no fusion",
          "env": {
            "CUDAQ_FUSION_MAX_QUBITS": "0",
            "CUDAQ_FUSION_DIAGONAL_GATE_MAX_QUBITS": "0"
          },
          "qubits": [
            20,
            40
          ],
          "note": "diagnostic: one cuStateVec call per gate (unfused execution model); the default series stays primary"
        }
      ]
    },
    "baseline_lightning": {
      "enabled": true,
      "devices": [
        "lightning.gpu"
      ],
      "precisions_cpu": [
        "fp64"
      ],
      "precisions_gpu": [
        "fp32",
        "fp64"
      ],
      "qubits": [
        16,
        28
      ],
      "qubits_gpu": [
        16,
        32
      ],
      "qubits_gpu_fp64": [
        16,
        30
      ],
      "reps": 3,
      "timeout_s": 3600,
      "python": null,
      "quick": {
        "qubits": [
          16,
          20
        ],
        "qubits_gpu": [
          16,
          20
        ],
        "reps": 1
      }
    },
    "neutral": {
      "enabled": true,
      "sdks": [
        "qumo",
        "qiskit",
        "tket"
      ],
      "targets": [
        "sc_grid",
        "ion_all_to_all",
        "neutral_atom"
      ],
      "levels": [
        "default"
      ],
      "filter": "qb_small__",
      "max_qubits": 6,
      "job_timeout_s": 120,
      "timeout_s": 1800,
      "python": null,
      "quick": {
        "targets": [
          "sc_grid"
        ],
        "max_qubits": 4
      }
    },
    "qec": {
      "enabled": true,
      "args": [
        "--part",
        "A",
        "--shots",
        "20000"
      ],
      "timeout_s": 2400,
      "python": null,
      "quick": {
        "args": [
          "--part",
          "A",
          "--shots",
          "2000"
        ]
      }
    },
    "tests": {
      "enabled": true,
      "targets": [
        "test-gpu"
      ],
      "timeout_s": 3600,
      "quick": {
        "targets": [
          "test"
        ],
        "files": [
          "tests/test_json.mojo"
        ]
      }
    }
  }
}
