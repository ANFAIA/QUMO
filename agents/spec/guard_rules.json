{
 "schema": "qumo.guard_rules.v1",
 "about": "The one specification of the security rules of the two agent harnesses (agents/qumo_agents and agents/mojo). See README.md in this directory. Both harnesses load `lists` and run every entry of `vectors` through their real functions.",
 "lists": {
  "repo": {
   "skip_dirs": [
    ".git",
    ".pixi",
    ".venv",
    ".worktrees",
    "__pycache__",
    "build",
    "models",
    "node_modules"
   ],
   "secret_names": {
    "prefix": [
     ".env"
    ],
    "contains": [
     "secret",
     "credential",
     "id_rsa"
    ],
    "suffix": [
     ".pem",
     ".key"
    ]
   },
   "run_check_allowed": [
    [
     "run one Mojo test or example",
     [
      ".venv/bin/mojo",
      "run",
      "-I",
      "."
     ]
    ],
    [
     "run one example with its checks",
     [
      "bench/.venv/bin/python",
      "examples/run_examples.py",
      "--only"
     ]
    ],
    [
     "run the hardware plugin tests",
     [
      "bench/.venv/bin/python",
      "-m",
      "pytest",
      "-q",
      "plugins/hardware/tests"
     ]
    ],
    [
     "QUMO CLI",
     [
      "build/qumo"
     ]
    ],
    [
     "git status or diff of the sandbox",
     [
      "git",
      "diff"
     ]
    ],
    [
     "git status of the sandbox",
     [
      "git",
      "status",
      "--short"
     ]
    ]
   ],
   "arg_chars": {
    "ranges": [
     "A-Z",
     "a-z",
     "0-9"
    ],
    "others": "_./:=,@+-"
   },
   "git_flags": [
    "--stat",
    "--name-only",
    "--name-status",
    "--cached",
    "--staged",
    "--"
   ],
   "qumo_subcommands": [
    "run",
    "statevector",
    "expect",
    "transpile",
    "emulate",
    "validate",
    "info",
    "draw",
    "convert",
    "vqe",
    "describe",
    "version",
    "help"
   ],
   "qumo_output_options": [
    "-o",
    "--output"
   ],
   "qumo_options": [
    "--shots",
    "--seed",
    "--params",
    "--max-qubits",
    "--max-iterations",
    "--device",
    "--precision",
    "--json",
    "--pretty",
    "--max-amplitudes",
    "--observable",
    "--target",
    "--level",
    "--basis",
    "--pipeline",
    "--qasm",
    "--compile",
    "--no-compile",
    "--width",
    "--unicode",
    "--to",
    "--instructions",
    "--layers",
    "--entanglement",
    "--optimizer",
    "--gradient",
    "--maxiter",
    "--qubits",
    "-h",
    "--help"
   ]
  },
  "env": {
   "secret_name_substrings": [
    "TOKEN",
    "SECRET",
    "KEY",
    "PASSWORD",
    "CREDENTIAL",
    "COOKIE"
   ],
   "check_env_extra_substrings": [
    "AUTH",
    "SESSION"
   ],
   "git_injected": {
    "exact": [
     "GIT_CONFIG_COUNT",
     "GIT_CONFIG_PARAMETERS"
    ],
    "numbered": [
     "GIT_CONFIG_KEY_",
     "GIT_CONFIG_VALUE_"
    ]
   },
   "cli_own_prefixes": {
    "claude_code": [
     "ANTHROPIC_",
     "CLAUDE_",
     "ALPHAXIV_"
    ],
    "codex": [
     "OPENAI_",
     "CODEX_",
     "ALPHAXIV_"
    ]
   },
   "minimal_child_env": [
    "HOME",
    "LOGNAME",
    "PATH",
    "SHELL",
    "TERM",
    "USER",
    "LANG",
    "LC_ALL",
    "LC_CTYPE",
    "TMPDIR"
   ]
  },
  "research": {
   "scheme": "https",
   "port": 443,
   "api_hosts": [
    "export.arxiv.org",
    "pypi.org",
    "api.github.com"
   ],
   "max_redirects": 3,
   "embedded_ipv4_prefixes": [
    "64:ff9b::/96"
   ],
   "refused_networks": [
    "::/96",
    "ff00::/8",
    "224.0.0.0/4"
   ]
  },
  "model_key": {
   "plain_http_loopback": {
    "names": [
     "localhost"
    ],
    "name_suffixes": [
     ".localhost"
    ],
    "networks": [
     "127.0.0.0/8",
     "::1/128"
    ]
   }
  },
  "delegation": {
   "web_groups": [
    "research"
   ],
   "exec_groups": [
    "check"
   ]
  },
  "untrusted": {
   "marker": "UNTRUSTED-DATA",
   "max_answer_chars": 6000,
   "max_report_chars": 60000
  }
 },
 "reasons": {
  "path": {
   "not_readable": [
    "is not readable by agents"
   ],
   "outside": [
    "is outside"
   ]
  },
  "command": {
   "not_allowlisted": [
    "refused: not on the allow-list"
   ],
   "bad_argument": [
    "refused: arguments may only hold path-like characters"
   ],
   "absolute_path": [
    "refused: absolute paths are not allowed"
   ],
   "qumo_subcommand": [
    "refused: build/qumo subcommands allowed here"
   ],
   "qumo_option": [
    "is not allowed here"
   ],
   "qumo_output_needs_sandbox": [
    "output options write a file"
   ],
   "qumo_output_needs_path": [
    "needs a path"
   ],
   "path_not_readable": [
    "is not readable by agents"
   ],
   "path_outside": [
    "is outside"
   ],
   "git_option": [
    "refused: git options allowed here"
   ]
  },
  "url": {
   "scheme": [
    "only https URLs are fetched",
    "only http and https URLs are supported"
   ],
   "credentials": [
    "URLs with credentials are refused",
    "user information in URLs is not supported"
   ],
   "port": [
    "only the default https port is fetched"
   ],
   "no_host": [
    "URL has no host",
    "no host",
    "invalid host"
   ],
   "host_not_listed": [
    "is not on the allow-list for this tool"
   ],
   "not_public": [
    "is not a public address"
   ],
   "too_many_redirects": [
    "too many redirects"
   ]
  }
 },
 "path_fixture": {
  "note": "Both tests build this tree in a temp directory: <tmp>/root is the root, <tmp>/outside is not.",
  "files": [
   "root/src/a.mojo",
   "root/docs/readme.md",
   "root/src/.env",
   "root/keys/server.pem",
   "root/.git/config",
   "outside/file.txt"
  ],
  "symlinks": [
   [
    "root/link_out",
    "../outside"
   ],
   [
    "root/link_env",
    "src/.env"
   ],
   [
    "root/link_git",
    ".git"
   ],
   [
    "root/link_src",
    "src"
   ]
  ]
 },
 "vectors": [
