(Copyright (c) LangChain, Inc., MIT License; see agents/mojo/LICENSES/langchain-MIT.txt).

Verbatim deepagents / langchain / langgraph texts (DESIGN.md Appendix A) and the texts
written for this port's merged file tools (Appendix B.1).

GENERATED by agents/mojo/tests/golden/gen_texts.py from
agents/mojo/tests/golden/deepagents_golden.json. Do not edit by hand.

`{name}` fields are Python `str.format` placeholders; the harness fills them with
`String.replace`. `*_PARAMETERS` constants are compact JSON texts (key order kept).
"""

# --- texts ----------------------------------------------------------------------
comptime LS_DESCRIPTION = "Lists all files in a directory.\n\nThis is useful for exploring the filesystem and finding the right file to read or edit.\nYou should almost ALWAYS use this tool before using the read_file or edit_file tools."
comptime READ_FILE_DESCRIPTION = "Reads a file from the filesystem. Assume any path the user provides is valid; reading a missing file returns an error.\n\nUsage:\n- By default, it reads up to 100 lines starting from the beginning of the file. Use `offset`/`limit` to page through large files instead of reading them whole.\n- A status header, `@@ field | field | ... @@`, sits above the file content, and every line after it is verbatim file content. When content is truncated, there may be an explanation before the header. Never include the header when editing.\n- Speculatively batch multiple `read_file` calls in one response when several files may be useful.\n- An empty file returns a system-reminder warning in place of contents.\n- Large tool results may be offloaded to a file; the tool message gives the path. Read that path here, paging with `offset`/`limit`.\n- Images (`.png`, `.jpg`, etc.), audio, video, and PDFs return multimodal content blocks (https://docs.langchain.com/oss/python/langchain/messages#multimodal).\n- For images and PDFs, pagination via `offset`/`limit` is text-only - supply `file_path` only\n- Always read a file before editing it."
comptime WRITE_FILE_DESCRIPTION = "Writes content to a file. Creates the file if it does not exist; replaces it entirely if it does.\n\nUsage:\n- Use this tool when you intend to create a new file or replace the whole file. You do not need to read the file first.\n- Prefer to edit existing files (with the edit_file tool) over creating new ones when possible."
comptime EDIT_FILE_DESCRIPTION = "Performs exact string replacements in files.\n\nUsage:\n- You must read the file before editing; this tool errors otherwise.\n- Preserve the exact source indentation from the read output, and never include the read status header in old_string or new_string.\n- Prefer editing an existing file over creating a new one.\n- Only use emojis if the user explicitly requests it."
comptime DELETE_DESCRIPTION = "Deletes a file or directory from the filesystem.\n\nUsage:\n- Permanently removes the file or directory at the given absolute path.\n- Deleting a directory removes it and everything inside it, recursively. Prefer\n  deleting a directory in one call over deleting each file individually.\n- This cannot be undone, so only delete paths you are sure are no longer needed."
comptime GLOB_DESCRIPTION = "Find files matching a glob pattern, returning absolute paths.\n\nSupports `*` (any characters within a path segment), `**` (any directories), `?` (single character), `[abc]` (one character from a set), and `{a,b}` (alternatives), e.g. `*.py`, `src/**/*.py`, `*.{yml,yaml}`.\n\nA pattern without `/` matches the file name at any depth under the search root (`*.py` matches `src/app/main.py`). A pattern containing `/` matches the search-root-relative path (`src/**/*.py`). A leading `/` anchors to the search root (`/*.py` matches only top-level Python files).\n\nLeading-dot names are only matched when the pattern segment itself starts with `.` (use `.env`, or `.github/**/*.yml`). Because `**` will not descend into dot-directories, the bare form `*.yml` is *broader* than `**/*.yml` and is usually what you want."
comptime GREP_DESCRIPTION = "Search for a LITERAL text pattern across files (NOT regex).\n\nThe pattern is matched verbatim: regex metacharacters are ordinary characters, not operators. To match any of several strings, run a separate grep for each; `grep(pattern=\"foo|bar\")` searches for the literal text \"foo|bar\", and `.*` or `\\.` match those characters literally.\n\nReturns matching files or content per `output_mode`. Offloaded large tool results live under the artifacts root (`/large_tool_results/` by default); grep that directory to search them when you do not know the exact path."
comptime TOO_LARGE_TOOL_MSG = "Tool result too large, the result of this tool call {tool_call_id} was saved in the filesystem at this path: {file_path}\n\nYou can read the result from the filesystem by using the read_file tool, but make sure to only read part of the result at a time.\n\nYou can do this by specifying an offset and limit in the read_file tool call. For example, to read the first 100 lines, you can use the read_file tool with offset=0 and limit=100.\n\n{preview_note}\n\n{content_sample}\n"
comptime PREVIEW_NOTE_PLAIN = "Here is a preview of the {subject}"
comptime PREVIEW_NOTE_HEAD_TAIL = "Here is a preview showing the head and tail of the {subject}"
comptime CAVEAT_OMITTED_LINES = "lines of the form `... [N lines truncated] ...` indicate omitted lines in the middle of the content"
comptime CAVEAT_CLIPPED_LINES = "the output contains lines longer than 1000 characters; this preview shows only their first 1000 characters"
comptime TRUNCATION_MARKER = "... [{omitted_lines} lines truncated] ..."
comptime TOO_LARGE_HUMAN_MSG = "Message content too large and was saved to the filesystem at: {file_path}\n\nYou can read the full content using the read_file tool with pagination (offset and limit parameters).\n\n{preview_note}\n\n{content_sample}\n"
comptime TASK_DESCRIPTION_TEMPLATE = "Launch an ephemeral subagent to handle a complex, multi-step task.\n\nAvailable agent types and the tools they have access to:\n{available_agents}\n\nSpecify subagent_type to select the agent. Usage notes:\n- Launch multiple agents concurrently when their tasks are independent, using a single message with multiple tool calls.\n- Each invocation is stateless by default: the agent sees only the prompt you give it and returns a single final report. Put full detail in the prompt and state exactly what it should return — unless an agent type below says it inherits your conversation instead.\n- The agent's report is not shown to the user; relay a summary yourself.\n- Tell the agent whether to create content, analyze, or only research, since it can't necessarily see the user's intent unless it inherits your conversation, as noted per agent type below.\n- If an agent's description says to use it proactively, do so without waiting to be asked.\n- When only general-purpose is available, use it for any complex, context-heavy task; it has the same capabilities as the main agent."
comptime TASK_UNKNOWN_SUBAGENT_ERROR = "We cannot invoke subagent {subagent_type} because it does not exist, the only allowed types are {allowed_types}"
comptime TASK_UNEXPECTED_ARGUMENT_MSG = "Value error, Unexpected argument '{key}'; put all instructions for the subagent in `description`."
comptime GENERAL_PURPOSE_DESCRIPTION = "General-purpose agent for researching complex questions, searching for files and content, and executing multi-step tasks. When you are searching for a keyword or file and are not confident that you will find the right match in the first few tries use this agent to perform the search for you. This agent has access to all tools as the main agent."
comptime DEFAULT_SUBAGENT_PROMPT = "In order to complete the objective that the user asks of you, you have access to a number of standard tools.\n\nThe calling agent only sees your final assistant message, not your intermediate work, tool results, or status tracking. Ensure your final\nresponse contains the complete answer."
comptime SUMMARY_PROMPT_TEMPLATE = "<role>\nContext Extraction Assistant\n</role>\n\n<primary_objective>\nYour sole objective in this task is to extract the highest quality/most relevant context from the conversation history below.\n</primary_objective>\n\n<objective_information>\nYou're nearing the total number of input tokens you can accept, so you must extract the highest quality/most relevant pieces of information from your conversation history.\nThis context will then overwrite the conversation history presented below. Because of this, ensure the context you extract is only the most important information to continue working toward your overall goal.\n</objective_information>\n\n<instructions>\nThe conversation history below will be replaced with the context you extract in this step.\nYou want to ensure that you don't repeat any actions you've already completed, so the context you extract from the conversation history should be focused on the most important information to your overall goal.\n\nYou should structure your summary using the following sections. Each section acts as a checklist - you must populate it with relevant information or explicitly state \"None\" if there is nothing to report for that section:\n\n## SESSION INTENT\n\nWhat is the user's primary goal or request? What overall task are you trying to accomplish? This should be concise but complete enough to understand the purpose of the entire session.\n\n## SUMMARY\n\nExtract and record all of the most important context from the conversation history. Include important choices, conclusions, or strategies determined during this conversation. Include the reasoning behind key decisions. Document any rejected options and why they were not pursued.\n\n## ARTIFACTS\n\nWhat artifacts, files, or resources were created, modified, or accessed during this conversation? For file modifications, list specific file paths and briefly describe the changes made to each. This section prevents silent loss of artifact information.\n\n## NEXT STEPS\n\nWhat specific tasks remain to be completed to achieve the session intent? What should you do next?\n\n</instructions>\n\nThe user will message you with the full message history from which you'll extract context to create a replacement. Carefully read through it all and think deeply about what information is most important to your overall goal and should be saved:\n\nWith all of this in mind, please carefully read over the entire conversation history, and extract the most important and relevant context to replace it so that you can free up space in the conversation history.\nRespond ONLY with the extracted context. Do not include any additional information, or text before or after the extracted context.\n\n<media_reference_information>\nConversation history may include XML media reference tags, for example:\n<image url=\"/conversation_history/media/{{hash}}.png\" />\nThese tags mean the original message included media that was preserved at the referenced backend path.\nTreat the tag and path as part of the conversation context. Do not infer visual details that are not available from surrounding text.\nWhen the media could be important for future context, preserve the media reference in your summary.\nThe model consuming the summary can call `read_file` on the referenced path if it needs to inspect the media.\n</media_reference_information>\n\n<messages>\nMessages to summarize:\n{messages}\n</messages>"
comptime SUMMARY_WITH_FILE = "You are in the middle of a conversation that has been summarized.\n\nThe full conversation history has been saved to {file_path} should you need to refer back to it for details.\n\nA condensed summary follows:\n\n<summary>\n{summary}\n</summary>"
comptime SUMMARY_WITHOUT_FILE = "Here is a summary of the conversation to date:\n\n{summary}"
comptime SUMMARY_NO_HISTORY = "No previous conversation history."
comptime SUMMARY_TOO_LONG = "Previous conversation was too long to summarize."
comptime SUMMARY_HISTORY_SECTION = "## Summarized at {timestamp}\n\n{xml}\n\n"
comptime SUMMARY_OVERFLOW_MIDDLE = "\n\n[... middle of conversation omitted ...]\n\n"
comptime ARG_TRUNCATION_SUFFIX = "...(argument truncated)"
comptime INVALID_TOOL_NAME = "Error: {requested_tool} is not a valid tool, try one of [{available_tools}]."
comptime TOOL_INVOCATION_ERROR = "Error invoking tool '{tool_name}' with kwargs {tool_kwargs} with error:\n {error}\n Please fix the error and try again."
comptime ERR_MALFORMED_TOOL_CALL = "Tool call {name} with id {tool_call_id} could not be executed - arguments were malformed or truncated."
comptime ERR_DANGLING_TOOL_CALL = "Tool call {name} with id {tool_call_id} did not complete - no result was recorded. It may have been cancelled or interrupted."
comptime ERR_EXECUTE_UNAVAILABLE = "Error: Execution not available. This agent's backend does not support command execution (SandboxBackendProtocol). To use the execute tool, provide a backend that implements SandboxBackendProtocol."
comptime ERR_PARALLEL_MUTATION = "Error: parallel file mutations to the same path are not allowed."
comptime ERR_PATH_TRAVERSAL = "Path traversal not allowed: {path}"
comptime ERR_WINDOWS_PATH = "Windows absolute paths are not supported: {path}. Please use virtual paths starting with / (e.g., /workspace/file.txt)"
comptime ERR_PATH_TRAVERSAL_AFTER_NORMALIZE = "Path traversal detected after normalization: {path} -> {normalized}"
comptime ERR_GLOB_TRAVERSAL = "Path traversal not allowed in glob pattern {pattern_repr}"
comptime ERR_GLOB_INVALID = "Invalid glob pattern {pattern_repr}: {reason}"
comptime ERR_FILE_NOT_FOUND = "Error: File '{file_path}' not found"
comptime ERR_OFFSET_PAST_END = "Error: Line offset {offset} exceeds file length ({total_lines} lines)"
comptime OUT_UPDATED_FILE = "Updated file {path}"
comptime OUT_DELETED = "Deleted {path}"
comptime OUT_NO_FILES = "No files found"
comptime OUT_NO_MATCHES = "No matches found"
comptime RECURSION_LIMIT = "Recursion limit of {limit} reached without hitting a stop condition. You can increase the limit by setting the `recursion_limit` config key."
comptime EMPTY_CONTENT_WARNING = "System reminder: File exists but has empty contents"
comptime NO_LINES_REQUESTED_WARNING = "System reminder: no lines were read because `limit` was {limit}. The file was not inspected and may have contents; retry with `limit` >= 1 to read it."
comptime READ_NEGATIVE_OFFSET_NOTICE = "[Requested offset {offset} is before the start of the file; read from line 1 instead.]"
comptime READ_FILE_TRUNCATION_MSG = "\n\n[Output was truncated due to size limits. The file content is very large. Consider reformatting the file to make it easier to navigate. For example, if this is JSON, use execute(command='jq . {file_path}') to pretty-print it with line breaks. For other formats, you can use appropriate formatting tools to split long lines.]"
comptime READ_HEADER = "@@ {fields} @@"
comptime READ_FIELD_LINES = "lines {start}-{end} of {total}"
comptime READ_FIELD_NEXT = "next offset {next_offset}"
comptime READ_FIELD_TRUNCATED = "truncated due to size"
comptime READ_FIELD_MIDLINE = "truncated mid-line"
comptime READ_FIELD_MIDLINE_COUNT = "{shown} of {oversized} chars"
comptime EDIT_EMPTY_OLD_STRING = "Error: old_string cannot be empty. Provide the exact text to replace."
comptime EDIT_NOT_FOUND = "Error: String not found in file: '{old_string}'"
comptime EDIT_EOF_NEWLINE_UNIQUE = "Error: old_string ends with a newline, but the file does not end with a newline. Retry with the trailing newline removed from old_string (and from new_string if it also ends with a newline)."
comptime EDIT_EOF_NEWLINE_AMBIGUOUS = "Error: old_string ends with a newline, but the file does not end with a newline. With the trailing newline removed, old_string would appear {stripped_count} times in the file. Retry with the trailing newline removed and add surrounding context so the match is unique."
comptime EDIT_MULTIPLE = "Error: String '{old_string}' appears {occurrences} times in file. Use replace_all=True to replace all instances, or provide a more specific string with surrounding context."
comptime EDIT_SUCCESS = "Successfully replaced {occurrences} instance(s) of the string in '{path}'"
comptime TRUNCATION_GUIDANCE = "... [results truncated, try being more specific with your parameters]"
comptime GREP_TRUNCATION_NOTE = "Note: the search stopped early (it hit its time limit or the maximum match count). The matches above are valid but incomplete. Narrow the search (a more specific pattern or a narrower path), or raise max_count, to see the rest."
comptime GREP_REGEX_HINT = "Note: grep matches literal text, not regex, so characters like `|`, `.*`, and `\\.` are searched verbatim. Search for the literal text you need instead; for `|` alternation, run a separate search per alternative."
comptime MEDIA_PLACEHOLDER = "[read_file: {path} was not attached because this model does not support {type} content ({mime}).]"
comptime OVERFLOW_READ_FILE_NOTICE = "\n\n[Output was truncated due to context window size limits. The full content is at {original_path}. Use read_file with offset and limit parameters to retrieve specific portions. For example, to read the first 100 lines, call read_file with file_path='{original_path}', offset=0, limit=100.]"
comptime OVERFLOW_RECOVERY_EXHAUSTED = "Model input still does not fit after recovery; reduce input, tools, or configured output tokens."
comptime OVERFLOW_HISTORY_OFFLOAD_FAILED = "Offloading conversation history to backend failed during summarization. Older messages will not be recoverable."
comptime READ_FILE_NOTES_V0 = "QUMO notes:\n- `path` is accepted as another name for `file_path`, `start_line` (1-based, start_line = offset + 1) for `offset`, and `max_lines` for `limit`.\n- Every path is in the virtual file system of this run; a relative path is taken from its root (`notes.md` is `/notes.md`)."
comptime READ_FILE_NOTES_V12 = "QUMO notes:\n- A path that starts with `/` is in the virtual file system of this run (the files of ls, glob, grep and write_file, including offloaded results under /large_tool_results/) and is read as described above.\n- A relative path such as `qumo/ir/circuit.mojo` is a file of the QUMO repository (or of the open sandbox, once one is open), read-only. It comes back with line numbers as `N<TAB>line`, at most 60000 characters, followed by `... (N lines total)` when lines remain; page with `start_line` (1-based, default 1) and `max_lines` (default 400, at most 2000).\n- `path` is accepted as another name for `file_path`; `offset`/`limit` and `start_line`/`max_lines` are converted into each other (start_line = offset + 1)."
comptime WRITE_FILE_NOTES_V0 = "QUMO notes:\n- `path` is accepted as another name for `file_path`.\n- Every path is in the virtual file system of this run; a relative path is taken from its root (`notes.md` is `/notes.md`)."
comptime WRITE_FILE_NOTES_V1 = "QUMO notes:\n- `path` is accepted as another name for `file_path`.\n- Only paths that start with `/` can be written: they are in the virtual file system of this run, which disappears when the run ends. Relative paths name files of the QUMO repository, which is read-only for this agent; save results with write_report."
comptime WRITE_FILE_NOTES_V2 = "QUMO notes:\n- `path` is accepted as another name for `file_path`.\n- A path that starts with `/` is in the virtual file system of this run, which disappears when the run ends.\n- A relative path such as `qumo/ir/circuit.mojo` is a file of the open sandbox worktree (call open_sandbox first; the main checkout is never written). Parent directories are created and the result is `wrote <path> (<N> chars)`."
comptime EDIT_FILE_NOTES_V0 = "QUMO notes:\n- `path`, `old` and `new` are accepted as other names for `file_path`, `old_string` and `new_string`.\n- Every path is in the virtual file system of this run; a relative path is taken from its root (`notes.md` is `/notes.md`)."
comptime EDIT_FILE_NOTES_V1 = "QUMO notes:\n- `path`, `old` and `new` are accepted as other names for `file_path`, `old_string` and `new_string`.\n- Only paths that start with `/` (the virtual file system of this run) can be edited. Relative paths name files of the QUMO repository, which is read-only for this agent."
comptime EDIT_FILE_NOTES_V2 = "QUMO notes:\n- `path`, `old` and `new` are accepted as other names for `file_path`, `old_string` and `new_string`.\n- A path that starts with `/` is in the virtual file system of this run.\n- A relative path is a file of the open sandbox worktree (call open_sandbox first). There `old_string` must occur exactly once unless replace_all is true, and the result is `edited <path>`."
comptime WRITE_RELATIVE_REFUSED = "Error: relative paths name files of the QUMO repository, which this agent cannot write. Write to the virtual file system with a path that starts with / (for example /notes.md), or save results with write_report."
comptime FILE_PATH_CONFLICT = "Error: file_path and path name different files; give only one."

# --- tool parameter schemas (wire JSON) ----------------------------------------
comptime LS_PARAMETERS = "{\"properties\":{\"path\":{\"description\":\"Absolute path to the directory to list. Must be absolute, not relative.\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}"
comptime READ_FILE_PARAMETERS = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path to the file to read. Must be absolute, not relative.\",\"type\":\"string\"},\"offset\":{\"default\":0,\"description\":\"Line number to start reading from (0-indexed). Use for pagination of large files.\",\"type\":\"integer\"},\"limit\":{\"default\":100,\"description\":\"Maximum number of lines to read. Use for pagination of large files.\",\"type\":\"integer\"}},\"required\":[\"file_path\"],\"type\":\"object\"}"
comptime WRITE_FILE_PARAMETERS = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path where the file should be written. Must be absolute, not relative.\",\"type\":\"string\"},\"content\":{\"description\":\"The text content to write to the file. This parameter is required.\",\"type\":\"string\"}},\"required\":[\"file_path\",\"content\"],\"type\":\"object\"}"
comptime EDIT_FILE_PARAMETERS = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path to the file to edit. Must be absolute, not relative.\",\"type\":\"string\"},\"old_string\":{\"description\":\"The exact text to find and replace. Must be unique in the file unless replace_all is True.\",\"type\":\"string\"},\"new_string\":{\"description\":\"The text to replace old_string with. Must be different from old_string.\",\"type\":\"string\"},\"replace_all\":{\"default\":false,\"description\":\"If True, replace all occurrences of old_string. If False (default), old_string must be unique.\",\"type\":\"boolean\"}},\"required\":[\"file_path\",\"old_string\",\"new_string\"],\"type\":\"object\"}"
comptime DELETE_PARAMETERS = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path to the file to delete. Must be absolute, not relative.\",\"type\":\"string\"}},\"required\":[\"file_path\"],\"type\":\"object\"}"
comptime GLOB_PARAMETERS = "{\"properties\":{\"pattern\":{\"description\":\"Glob pattern to match files (e.g., '*.py', '**/*.py', '/subdir/**/*.md'). A pattern without '/' matches the file name at any depth; a pattern containing '/' matches the search-root-relative path; a leading '/' anchors to the search root ('/*.py' matches only top-level files). Leading-dot names are excluded unless the pattern segment starts with '.', so prefer the bare form '*.py' over '**/*.py' -- '**' will not descend into dot-directories like '.github'.\",\"type\":\"string\"},\"path\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Base directory to search from. Defaults to the backend's default root.\"}},\"required\":[\"pattern\"],\"type\":\"object\"}"
comptime GREP_PARAMETERS = "{\"properties\":{\"pattern\":{\"description\":\"Text pattern to search for (literal string, not regex).\",\"type\":\"string\"},\"path\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Directory to search in. Defaults to current working directory.\"},\"glob\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Glob pattern (NOT regex) limiting which files are searched (e.g. '*.py', '*.ts'). A pattern without '/' matches the file name at any depth; a pattern containing '/' matches the search-root-relative path (e.g. 'src/**/*.py'). This is an in-tool file filter, not a call to the separate glob tool. Brace expansion (e.g. '*.{ts,tsx}') is not supported on all backends; run a separate search per extension for reliable results.\"},\"output_mode\":{\"default\":\"files_with_matches\",\"description\":\"Shape of the returned text. 'files_with_matches' (default): newline-separated matching file paths. 'content': matching lines grouped by file under a '<path>:' header, each line indented and formatted '<line_number>: <line text>' (only the matched line, no surrounding context). 'count': one '<path>: <match_count>' line per file.\",\"enum\":[\"files_with_matches\",\"content\",\"count\"],\"type\":\"string\"},\"max_count\":{\"anyOf\":[{\"exclusiveMinimum\":0,\"type\":\"integer\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Optional cap on the total number of matches returned across all files. Leave unset to use the configured default. When the cap is hit, results are truncated and a note says so; narrow the pattern or path to see the rest.\"}},\"required\":[\"pattern\"],\"type\":\"object\"}"
comptime TASK_PARAMETERS = "{\"properties\":{\"description\":{\"description\":\"A detailed description of the task for the subagent to perform autonomously. Include all necessary context and specify the expected output format.\",\"type\":\"string\"},\"subagent_type\":{\"description\":\"The type of subagent to use. Must be one of the available agent types listed in the tool description.\",\"type\":\"string\"}},\"required\":[\"description\",\"subagent_type\"],\"type\":\"object\"}"
comptime READ_FILE_PARAMETERS_V0 = "{\"properties\":{\"file_path\":{\"description\":\"Path of the file to read in the virtual file system; a relative path is taken from its root. Give file_path or path.\",\"type\":\"string\"},\"path\":{\"description\":\"Another name for file_path.\",\"type\":\"string\"},\"offset\":{\"default\":0,\"description\":\"Line number to start reading from (0-indexed). Use for pagination of large files.\",\"type\":\"integer\"},\"limit\":{\"default\":100,\"description\":\"Maximum number of lines to read. Use for pagination of large files.\",\"type\":\"integer\"},\"start_line\":{\"description\":\"First line to read, 1-based (start_line = offset + 1).\",\"type\":\"integer\"},\"max_lines\":{\"description\":\"Another name for limit.\",\"type\":\"integer\"}},\"type\":\"object\"}"
comptime READ_FILE_PARAMETERS_V12 = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path (virtual file system) or relative path (QUMO repository, or the open sandbox) of the file to read. Give file_path or path.\",\"type\":\"string\"},\"path\":{\"description\":\"Another name for file_path.\",\"type\":\"string\"},\"offset\":{\"default\":0,\"description\":\"Line number to start reading from (0-indexed). Use for pagination of large files.\",\"type\":\"integer\"},\"limit\":{\"default\":100,\"description\":\"Maximum number of lines to read. Use for pagination of large files.\",\"type\":\"integer\"},\"start_line\":{\"description\":\"First line to read, 1-based (start_line = offset + 1).\",\"type\":\"integer\"},\"max_lines\":{\"description\":\"Another name for limit; relative paths default to 400 and allow at most 2000.\",\"type\":\"integer\"}},\"type\":\"object\"}"
comptime WRITE_FILE_PARAMETERS_V0 = "{\"properties\":{\"file_path\":{\"description\":\"Path where the file should be written in the virtual file system; a relative path is taken from its root. Give file_path or path.\",\"type\":\"string\"},\"path\":{\"description\":\"Another name for file_path.\",\"type\":\"string\"},\"content\":{\"description\":\"The text content to write to the file. This parameter is required.\",\"type\":\"string\"}},\"required\":[\"content\"],\"type\":\"object\"}"
comptime WRITE_FILE_PARAMETERS_V1 = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path where the file should be written (virtual file system of this run). Give file_path or path.\",\"type\":\"string\"},\"path\":{\"description\":\"Another name for file_path.\",\"type\":\"string\"},\"content\":{\"description\":\"The text content to write to the file. This parameter is required.\",\"type\":\"string\"}},\"required\":[\"content\"],\"type\":\"object\"}"
comptime WRITE_FILE_PARAMETERS_V2 = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path (virtual file system) or relative path (open sandbox) where the file should be written. Give file_path or path.\",\"type\":\"string\"},\"path\":{\"description\":\"Another name for file_path.\",\"type\":\"string\"},\"content\":{\"description\":\"The text content to write to the file. This parameter is required.\",\"type\":\"string\"}},\"required\":[\"content\"],\"type\":\"object\"}"
comptime EDIT_FILE_PARAMETERS_V0 = "{\"properties\":{\"file_path\":{\"description\":\"Path to the file to edit in the virtual file system; a relative path is taken from its root. Give file_path or path.\",\"type\":\"string\"},\"path\":{\"description\":\"Another name for file_path.\",\"type\":\"string\"},\"old_string\":{\"description\":\"The exact text to find and replace. Must be unique in the file unless replace_all is True.\",\"type\":\"string\"},\"new_string\":{\"description\":\"The text to replace old_string with. Must be different from old_string.\",\"type\":\"string\"},\"replace_all\":{\"default\":false,\"description\":\"If True, replace all occurrences of old_string. If False (default), old_string must be unique.\",\"type\":\"boolean\"},\"old\":{\"description\":\"Another name for old_string.\",\"type\":\"string\"},\"new\":{\"description\":\"Another name for new_string.\",\"type\":\"string\"}},\"type\":\"object\"}"
comptime EDIT_FILE_PARAMETERS_V1 = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path to the file to edit (virtual file system of this run). Give file_path or path.\",\"type\":\"string\"},\"path\":{\"description\":\"Another name for file_path.\",\"type\":\"string\"},\"old_string\":{\"description\":\"The exact text to find and replace. Must be unique in the file unless replace_all is True.\",\"type\":\"string\"},\"new_string\":{\"description\":\"The text to replace old_string with. Must be different from old_string.\",\"type\":\"string\"},\"replace_all\":{\"default\":false,\"description\":\"If True, replace all occurrences of old_string. If False (default), old_string must be unique.\",\"type\":\"boolean\"},\"old\":{\"description\":\"Another name for old_string.\",\"type\":\"string\"},\"new\":{\"description\":\"Another name for new_string.\",\"type\":\"string\"}},\"type\":\"object\"}"
comptime EDIT_FILE_PARAMETERS_V2 = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path (virtual file system) or relative path (open sandbox) of the file to edit. Give file_path or path.\",\"type\":\"string\"},\"path\":{\"description\":\"Another name for file_path.\",\"type\":\"string\"},\"old_string\":{\"description\":\"The exact text to find and replace. Must be unique in the file unless replace_all is True.\",\"type\":\"string\"},\"new_string\":{\"description\":\"The text to replace old_string with. Must be different from old_string.\",\"type\":\"string\"},\"replace_all\":{\"default\":false,\"description\":\"If True, replace all occurrences of old_string. If False (default), old_string must be unique.\",\"type\":\"boolean\"},\"old\":{\"description\":\"Another name for old_string.\",\"type\":\"string\"},\"new\":{\"description\":\"Another name for new_string.\",\"type\":\"string\"}},\"type\":\"object\"}"

# --- token-count schemas (tool_call_schema minus top-level title/description) ---
comptime COUNT_PARAMETERS_LS = "{\"properties\":{\"path\":{\"description\":\"Absolute path to the directory to list. Must be absolute, not relative.\",\"title\":\"Path\",\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}"
comptime COUNT_PARAMETERS_READ_FILE = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path to the file to read. Must be absolute, not relative.\",\"title\":\"File Path\",\"type\":\"string\"},\"offset\":{\"default\":0,\"description\":\"Line number to start reading from (0-indexed). Use for pagination of large files.\",\"title\":\"Offset\",\"type\":\"integer\"},\"limit\":{\"default\":100,\"description\":\"Maximum number of lines to read. Use for pagination of large files.\",\"title\":\"Limit\",\"type\":\"integer\"}},\"required\":[\"file_path\"],\"type\":\"object\"}"
comptime COUNT_PARAMETERS_WRITE_FILE = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path where the file should be written. Must be absolute, not relative.\",\"title\":\"File Path\",\"type\":\"string\"},\"content\":{\"description\":\"The text content to write to the file. This parameter is required.\",\"title\":\"Content\",\"type\":\"string\"}},\"required\":[\"file_path\",\"content\"],\"type\":\"object\"}"
comptime COUNT_PARAMETERS_EDIT_FILE = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path to the file to edit. Must be absolute, not relative.\",\"title\":\"File Path\",\"type\":\"string\"},\"old_string\":{\"description\":\"The exact text to find and replace. Must be unique in the file unless replace_all is True.\",\"title\":\"Old String\",\"type\":\"string\"},\"new_string\":{\"description\":\"The text to replace old_string with. Must be different from old_string.\",\"title\":\"New String\",\"type\":\"string\"},\"replace_all\":{\"default\":false,\"description\":\"If True, replace all occurrences of old_string. If False (default), old_string must be unique.\",\"title\":\"Replace All\",\"type\":\"boolean\"}},\"required\":[\"file_path\",\"old_string\",\"new_string\"],\"type\":\"object\"}"
comptime COUNT_PARAMETERS_DELETE = "{\"properties\":{\"file_path\":{\"description\":\"Absolute path to the file to delete. Must be absolute, not relative.\",\"title\":\"File Path\",\"type\":\"string\"}},\"required\":[\"file_path\"],\"type\":\"object\"}"
comptime COUNT_PARAMETERS_GLOB = "{\"properties\":{\"pattern\":{\"description\":\"Glob pattern to match files (e.g., '*.py', '**/*.py', '/subdir/**/*.md'). A pattern without '/' matches the file name at any depth; a pattern containing '/' matches the search-root-relative path; a leading '/' anchors to the search root ('/*.py' matches only top-level files). Leading-dot names are excluded unless the pattern segment starts with '.', so prefer the bare form '*.py' over '**/*.py' -- '**' will not descend into dot-directories like '.github'.\",\"title\":\"Pattern\",\"type\":\"string\"},\"path\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Base directory to search from. Defaults to the backend's default root.\",\"title\":\"Path\"}},\"required\":[\"pattern\"],\"type\":\"object\"}"
comptime COUNT_PARAMETERS_GREP = "{\"properties\":{\"pattern\":{\"description\":\"Text pattern to search for (literal string, not regex).\",\"title\":\"Pattern\",\"type\":\"string\"},\"path\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Directory to search in. Defaults to current working directory.\",\"title\":\"Path\"},\"glob\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Glob pattern (NOT regex) limiting which files are searched (e.g. '*.py', '*.ts'). A pattern without '/' matches the file name at any depth; a pattern containing '/' matches the search-root-relative path (e.g. 'src/**/*.py'). This is an in-tool file filter, not a call to the separate glob tool. Brace expansion (e.g. '*.{ts,tsx}') is not supported on all backends; run a separate search per extension for reliable results.\",\"title\":\"Glob\"},\"output_mode\":{\"default\":\"files_with_matches\",\"description\":\"Shape of the returned text. 'files_with_matches' (default): newline-separated matching file paths. 'content': matching lines grouped by file under a '<path>:' header, each line indented and formatted '<line_number>: <line text>' (only the matched line, no surrounding context). 'count': one '<path>: <match_count>' line per file.\",\"enum\":[\"files_with_matches\",\"content\",\"count\"],\"title\":\"Output Mode\",\"type\":\"string\"},\"max_count\":{\"anyOf\":[{\"exclusiveMinimum\":0,\"type\":\"integer\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Optional cap on the total number of matches returned across all files. Leave unset to use the configured default. When the cap is hit, results are truncated and a note says so; narrow the pattern or path to see the rest.\",\"title\":\"Max Count\"}},\"required\":[\"pattern\"],\"type\":\"object\"}"
comptime COUNT_PARAMETERS_TASK = "{\"properties\":{\"description\":{\"description\":\"A detailed description of the task for the subagent to perform autonomously. Include all necessary context and specify the expected output format.\",\"title\":\"Description\",\"type\":\"string\"},\"subagent_type\":{\"description\":\"The type of subagent to use. Must be one of the available agent types listed in the tool description.\",\"title\":\"Subagent Type\",\"type\":\"string\"}},\"required\":[\"description\",\"subagent_type\"],\"type\":\"object\"}"

# --- A.11 non-text extensions: (lower-cased suffix, content type, mime) ---
comptime MEDIA_EXTENSIONS: List[String] = [".png", ".jpeg", ".jpg", ".webp", ".gif", ".heic", ".heif", ".mp4", ".mpeg", ".mov", ".avi", ".flv", ".mpg", ".webm", ".wmv", ".3gpp", ".mkv", ".wav", ".mp3", ".aiff", ".aac", ".ogg", ".flac", ".pdf", ".ppt", ".pptx"]
comptime MEDIA_TYPES: List[String] = ["image", "image", "image", "image", "image", "image", "image", "video", "video", "video", "video", "video", "video", "video", "video", "video", "video", "audio", "audio", "audio", "audio", "audio", "audio", "file", "file", "file"]
comptime MEDIA_MIMES: List[String] = ["image/png", "image/jpeg", "image/jpeg", "image/webp", "image/gif", "image/heic", "image/heif", "video/mp4", "video/mpeg", "video/quicktime", "video/x-msvideo", "video/x-flv", "video/mpeg", "video/webm", "video/x-ms-wmv", "audio/3gpp", "video/x-matroska", "audio/x-wav", "audio/mpeg", "audio/x-aiff", "audio/x-aac", "audio/ogg", "audio/x-flac", "application/pdf", "application/vnd.ms-powerpoint", "application/vnd.openxmlformats-officedocument.presentationml.presentation"]


def count_parameters(tool: String) -> String:
    """COUNT_PARAMETERS[tool] for the deepagents tools; "" for any other name."""
    if tool == "ls":
        return COUNT_PARAMETERS_LS
    if tool == "read_file":
        return COUNT_PARAMETERS_READ_FILE
    if tool == "write_file":
        return COUNT_PARAMETERS_WRITE_FILE
    if tool == "edit_file":
        return COUNT_PARAMETERS_EDIT_FILE
    if tool == "delete":
        return COUNT_PARAMETERS_DELETE
    if tool == "glob":
        return COUNT_PARAMETERS_GLOB
    if tool == "grep":
        return COUNT_PARAMETERS_GREP
    if tool == "task":
        return COUNT_PARAMETERS_TASK
    return String()


