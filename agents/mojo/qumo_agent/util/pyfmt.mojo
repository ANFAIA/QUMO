"""Python formats reproduced byte for byte: repr, json.dumps, str.splitlines,
str.split, str.strip, float repr, code-point slicing, xml.sax.saxutils escapes.

Every Python limit ported by the harness counts code points (D2f), and every text
the model sees that Python builds with one of these functions must come out the
same, so no other module re-implements them (DESIGN.md 0.5, 2.2.1).

Notes on exactness:

* `py_str_repr` decides which characters are printable with the exact table of
  Python 3.12 (Unicode 15.0.0): `_NONPRINTABLE` lists every range of code points
  at or above U+0080 for which `str.isprintable()` is false. It is generated by
  `agents/mojo/tests/golden/gen_pyfmt.py --table` (DESIGN.md 2.2.1 allowed an
  approximation; the table is exact instead).
* JSON values come from `qumo.ai.json`, which keeps an integer exact only up to
  2^64 (larger integers become floats) and does not accept `NaN`/`Infinity`
  literals; Python keeps arbitrary integers. Everything else matches.
* An object with a repeated key is formatted as Python's `dict` would hold it:
  the key at its first position with its last value.
"""

from std.math import isnan, isinf

from qumo.ai.json import JsonValue, JsonKind


# ---------------------------------------------------------------------------
# UTF-8 helpers
# ---------------------------------------------------------------------------
comptime _HEX = "0123456789abcdef"


@always_inline
def _cp_at(bs: Span[Byte, _], i: Int) -> Tuple[Int, Int]:
    """(code point, byte length) of the UTF-8 sequence starting at byte `i`."""
    var b0 = Int(bs[i])
    if b0 < 0x80:
        return (b0, 1)
    var n = len(bs)
    if b0 >= 0xF0 and i + 3 < n:
        return (((b0 & 0x07) << 18) | ((Int(bs[i + 1]) & 0x3F) << 12) | ((Int(bs[i + 2]) & 0x3F) << 6) | (Int(bs[i + 3]) & 0x3F), 4)
    if b0 >= 0xE0 and i + 2 < n:
        return (((b0 & 0x0F) << 12) | ((Int(bs[i + 1]) & 0x3F) << 6) | (Int(bs[i + 2]) & 0x3F), 3)
    if b0 >= 0xC0 and i + 1 < n:
        return (((b0 & 0x1F) << 6) | (Int(bs[i + 1]) & 0x3F), 2)
    return (b0, 1)


def _put_cp(mut out: List[UInt8], cp: Int):
    if cp < 0x80:
        out.append(UInt8(cp))
    elif cp < 0x800:
        out.append(UInt8(0xC0 | (cp >> 6)))
        out.append(UInt8(0x80 | (cp & 0x3F)))
    elif cp < 0x10000:
        out.append(UInt8(0xE0 | (cp >> 12)))
        out.append(UInt8(0x80 | ((cp >> 6) & 0x3F)))
        out.append(UInt8(0x80 | (cp & 0x3F)))
    else:
        out.append(UInt8(0xF0 | (cp >> 18)))
        out.append(UInt8(0x80 | ((cp >> 12) & 0x3F)))
        out.append(UInt8(0x80 | ((cp >> 6) & 0x3F)))
        out.append(UInt8(0x80 | (cp & 0x3F)))


def _put_str(mut out: List[UInt8], s: StringSlice):
    var bs = s.as_bytes()
    for i in range(len(bs)):
        out.append(bs[i])


def _put_bytes(mut out: List[UInt8], bs: Span[Byte, _], a: Int, b: Int):
    for i in range(a, b):
        out.append(bs[i])


def _put_hex(mut out: List[UInt8], v: Int, digits: Int):
    var hx = _HEX.as_bytes()
    var shift = 4 * (digits - 1)
    while shift >= 0:
        out.append(hx[(v >> shift) & 15])
        shift -= 4


def _finish(buf: List[UInt8]) -> String:
    return String(unsafe_from_utf8=Span(buf))


# ---------------------------------------------------------------------------
# Code points
# ---------------------------------------------------------------------------
def cp_len(s: String) -> Int:
    """len(s) in Python (code points)."""
    var bs = s.as_bytes()
    var n = 0
    for i in range(len(bs)):
        if (Int(bs[i]) & 0xC0) != 0x80:
            n += 1
    return n


def _cp_byte_offset(bs: Span[Byte, _], cp_index: Int) -> Int:
    """Byte offset of code point number `cp_index` (len(bs) past the end)."""
    var seen = 0
    for i in range(len(bs)):
        if (Int(bs[i]) & 0xC0) != 0x80:
            if seen == cp_index:
                return i
            seen += 1
    return len(bs)


def cp_slice(s: String, start: Int, stop: Int) -> String:
    """s[start:stop] with Python's negative-index and clamping rules."""
    var n = cp_len(s)
    var a = start
    var b = stop
    if a < 0:
        a += n
        if a < 0:
            a = 0
    elif a > n:
        a = n
    if b < 0:
        b += n
        if b < 0:
            b = 0
    elif b > n:
        b = n
    if b <= a:
        return String()
    var bs = s.as_bytes()
    if n == len(bs):
        return String(unsafe_from_utf8=bs[a:b])
    var ba = _cp_byte_offset(bs, a)
    var bb = _cp_byte_offset(bs, b)
    return String(unsafe_from_utf8=bs[ba:bb])


def cp_head(s: String, n: Int) -> String:
    """s[:n]."""
    return cp_slice(s, 0, n)


def cp_tail(s: String, n: Int) -> String:
    """s[-n:] (n <= 0 gives "")."""
    if n <= 0:
        return String()
    return cp_slice(s, -n, cp_len(s))


# ---------------------------------------------------------------------------
# repr
# ---------------------------------------------------------------------------
def _hexval(c: Int) -> Int:
    if c >= 0x30 and c <= 0x39:
        return c - 0x30
    return c - 0x61 + 10


def _table_int(t: Span[Byte, _], at: Int) -> Int:
    var v = 0
    for i in range(6):
        v = v * 16 + _hexval(Int(t[at + i]))
    return v


def _is_printable(cp: Int) -> Bool:
    """str.isprintable() of one code point (Python 3.12)."""
    if cp < 0x80:
        return cp >= 0x20 and cp != 0x7F
    var t = _NONPRINTABLE.as_bytes()
    var lo = 0
    var hi = (len(t) + 1) // 13 - 1
    while lo <= hi:
        var mid = (lo + hi) // 2
        var a = _table_int(t, mid * 13)
        var b = _table_int(t, mid * 13 + 6)
        if cp < a:
            hi = mid - 1
        elif cp > b:
            lo = mid + 1
        else:
            return False
    return True


def py_str_repr(s: String) -> String:
    """repr(s) for a str."""
    var bs = s.as_bytes()
    var n = len(bs)
    var has_sq = False
    var has_dq = False
    for i in range(n):
        if Int(bs[i]) == 0x27:
            has_sq = True
        elif Int(bs[i]) == 0x22:
            has_dq = True
    var quote = 0x22 if (has_sq and not has_dq) else 0x27
    var out = List[UInt8](capacity=n + 2)
    out.append(UInt8(quote))
    var i = 0
    while i < n:
        var c = Int(bs[i])
        if c < 0x80:
            if c == quote or c == 0x5C:
                out.append(0x5C)
                out.append(UInt8(c))
            elif c == 0x09:
                _put_str(out, "\\t")
            elif c == 0x0A:
                _put_str(out, "\\n")
            elif c == 0x0D:
                _put_str(out, "\\r")
            elif c < 0x20 or c == 0x7F:
                _put_str(out, "\\x")
                _put_hex(out, c, 2)
            else:
                out.append(UInt8(c))
            i += 1
            continue
        var d = _cp_at(bs, i)
        var cp = d[0]
        if _is_printable(cp):
            _put_bytes(out, bs, i, i + d[1])
        elif cp < 0x100:
            _put_str(out, "\\x")
            _put_hex(out, cp, 2)
        elif cp < 0x10000:
            _put_str(out, "\\u")
            _put_hex(out, cp, 4)
        else:
            _put_str(out, "\\U")
            _put_hex(out, cp, 8)
        i += d[1]
    out.append(UInt8(quote))
    return _finish(out)


def py_float_repr(x: Float64) -> String:
    """repr(float): shortest round-trip form (Mojo's String(Float64) is Python's)."""
    if isnan(x):
        return "nan"
    if isinf(x):
        return "inf" if x > 0 else "-inf"
    return String(x)


def _json_float(x: Float64) -> String:
    if isnan(x):
        return "NaN"
    if isinf(x):
        return "Infinity" if x > 0 else "-Infinity"
    return String(x)


def _is_float_node(v: JsonValue) -> Bool:
    var nd = v.arena[].nodes[v.idx]
    return not (nd.is_int or nd.is_uint)


def _number_repr(v: JsonValue, json_form: Bool) -> String:
    try:
        if _is_float_node(v):
            if json_form:
                return _json_float(v.as_float())
            return py_float_repr(v.as_float())
        return v.number_text()
    except:
        return "0"


def _members(v: JsonValue) -> List[Tuple[String, Int]]:
    """Object members as Python's dict holds them: (key, member index), each key at
    its first position with its last value."""
    var out = List[Tuple[String, Int]]()
    var n = len(v)
    for i in range(n):
        var k = v.key_at(i)
        var found = -1
        for j in range(len(out)):
            if out[j][0] == k:
                found = j
                break
        if found >= 0:
            out[found] = (k, i)
        else:
            out.append((k, i))
    return out^


def _repr_into(mut out: String, v: JsonValue):
    var k = v.kind()
    if k == JsonKind.NULL or k == JsonKind.UNDEFINED:
        out += "None"
    elif k == JsonKind.BOOL:
        var b = False
        try:
            b = v.as_bool()
        except:
            pass
        out += "True" if b else "False"
    elif k == JsonKind.NUMBER:
        out += _number_repr(v, False)
    elif k == JsonKind.STRING:
        try:
            out += py_str_repr(v.as_string())
        except:
            out += "''"
    elif k == JsonKind.ARRAY:
        out += "["
        for i in range(len(v)):
            if i > 0:
                out += ", "
            _repr_into(out, v.at(i))
        out += "]"
    else:
        out += "{"
        var ms = _members(v)
        for i in range(len(ms)):
            if i > 0:
                out += ", "
            out += py_str_repr(ms[i][0])
            out += ": "
            _repr_into(out, v.at(ms[i][1]))
        out += "}"


def py_repr_json(v: JsonValue) -> String:
    """repr() of the value json.loads() would return for this document."""
    var out = String()
    _repr_into(out, v)
    return out^


def py_list_repr(items: List[String]) -> String:
    """str(list_of_str)."""
    var out = String("[")
    for i in range(len(items)):
        if i > 0:
            out += ", "
        out += py_str_repr(items[i])
    out += "]"
    return out^


# ---------------------------------------------------------------------------
# json.dumps
# ---------------------------------------------------------------------------
def _dumps_string_into(mut out: List[UInt8], s: String, ensure_ascii: Bool):
    var bs = s.as_bytes()
    var n = len(bs)
    out.append(0x22)
    var i = 0
    while i < n:
        var c = Int(bs[i])
        if c < 0x80:
            if c == 0x22:
                _put_str(out, "\\\"")
            elif c == 0x5C:
                _put_str(out, "\\\\")
            elif c == 0x0A:
                _put_str(out, "\\n")
            elif c == 0x0D:
                _put_str(out, "\\r")
            elif c == 0x09:
                _put_str(out, "\\t")
            elif c == 0x08:
                _put_str(out, "\\b")
            elif c == 0x0C:
                _put_str(out, "\\f")
            elif c < 0x20 or (c == 0x7F and ensure_ascii):
                _put_str(out, "\\u")
                _put_hex(out, c, 4)
            else:
                out.append(UInt8(c))
            i += 1
            continue
        var d = _cp_at(bs, i)
        if not ensure_ascii:
            _put_bytes(out, bs, i, i + d[1])
        else:
            var cp = d[0]
            if cp >= 0x10000:
                var v = cp - 0x10000
                _put_str(out, "\\u")
                _put_hex(out, 0xD800 | (v >> 10), 4)
                _put_str(out, "\\u")
                _put_hex(out, 0xDC00 | (v & 0x3FF), 4)
            else:
                _put_str(out, "\\u")
                _put_hex(out, cp, 4)
        i += d[1]
    out.append(0x22)


def py_json_dumps_string(s: String, ensure_ascii: Bool) -> String:
    """json.dumps(s, ensure_ascii=...) for a str."""
    var out = List[UInt8](capacity=s.byte_length() + 2)
    _dumps_string_into(out, s, ensure_ascii)
    return _finish(out)


def _newline_indent(mut out: List[UInt8], indent: Int, level: Int):
    out.append(0x0A)
    for _ in range(indent * level):
        out.append(0x20)


def _dumps_into(mut out: List[UInt8], v: JsonValue, ensure_ascii: Bool, indent: Int, level: Int):
    var k = v.kind()
    if k == JsonKind.NULL or k == JsonKind.UNDEFINED:
        _put_str(out, "null")
    elif k == JsonKind.BOOL:
        var b = False
        try:
            b = v.as_bool()
        except:
            pass
        _put_str(out, "true" if b else "false")
    elif k == JsonKind.NUMBER:
        _put_str(out, _number_repr(v, True))
    elif k == JsonKind.STRING:
        var s = String()
        try:
            s = v.as_string()
        except:
            pass
        _dumps_string_into(out, s, ensure_ascii)
    elif k == JsonKind.ARRAY:
        var n = len(v)
        if n == 0:
            _put_str(out, "[]")
            return
        out.append(0x5B)
        for i in range(n):
            if i > 0:
                out.append(0x2C)
                if indent < 0:
                    out.append(0x20)
            if indent >= 0:
                _newline_indent(out, indent, level + 1)
            _dumps_into(out, v.at(i), ensure_ascii, indent, level + 1)
        if indent >= 0:
            _newline_indent(out, indent, level)
        out.append(0x5D)
    else:
        var ms = _members(v)
        if len(ms) == 0:
            _put_str(out, "{}")
            return
        out.append(0x7B)
        for i in range(len(ms)):
            if i > 0:
                out.append(0x2C)
                if indent < 0:
                    out.append(0x20)
            if indent >= 0:
                _newline_indent(out, indent, level + 1)
            _dumps_string_into(out, ms[i][0], ensure_ascii)
            _put_str(out, ": ")
            _dumps_into(out, v.at(ms[i][1]), ensure_ascii, indent, level + 1)
        if indent >= 0:
            _newline_indent(out, indent, level)
        out.append(0x7D)


def py_json_dumps(v: JsonValue, ensure_ascii: Bool, indent: Int) -> String:
    """json.dumps(v, ensure_ascii=..., indent=...); indent < 0 is indent=None
    (separators ", " and ": "), indent >= 0 the pretty form."""
    var out = List[UInt8]()
    _dumps_into(out, v, ensure_ascii, indent, 0)
    return _finish(out)


# ---------------------------------------------------------------------------
# str methods
# ---------------------------------------------------------------------------
def py_is_space(cp: Int) -> Bool:
    """str.isspace() for one code point."""
    if cp < 0x80:
        return (cp >= 0x09 and cp <= 0x0D) or (cp >= 0x1C and cp <= 0x20)
    return (cp == 0x85 or cp == 0xA0 or cp == 0x1680 or (cp >= 0x2000 and cp <= 0x200A)
            or cp == 0x2028 or cp == 0x2029 or cp == 0x202F or cp == 0x205F or cp == 0x3000)


def _is_line_break(cp: Int) -> Bool:
    return ((cp >= 0x0A and cp <= 0x0D) or (cp >= 0x1C and cp <= 0x1E) or cp == 0x85
            or cp == 0x2028 or cp == 0x2029)


def py_splitlines(s: String) -> List[String]:
    """str.splitlines() (line ends dropped)."""
    var out = List[String]()
    var bs = s.as_bytes()
    var n = len(bs)
    var start = 0
    var i = 0
    while i < n:
        var d = _cp_at(bs, i)
        if _is_line_break(d[0]):
            out.append(String(unsafe_from_utf8=bs[start:i]))
            var j = i + d[1]
            if d[0] == 0x0D and j < n and Int(bs[j]) == 0x0A:
                j += 1
            start = j
            i = j
        else:
            i += d[1]
    if start < n:
        out.append(String(unsafe_from_utf8=bs[start:n]))
    return out^


def py_split_ws(s: String) -> List[String]:
    """str.split() with no arguments."""
    var out = List[String]()
    var bs = s.as_bytes()
    var n = len(bs)
    var start = -1
    var i = 0
    while i < n:
        var d = _cp_at(bs, i)
        if py_is_space(d[0]):
            if start >= 0:
                out.append(String(unsafe_from_utf8=bs[start:i]))
                start = -1
        elif start < 0:
            start = i
        i += d[1]
    if start >= 0:
        out.append(String(unsafe_from_utf8=bs[start:n]))
    return out^


def _strip_bounds(s: String, left: Bool) -> Tuple[Int, Int]:
    var bs = s.as_bytes()
    var n = len(bs)
    var a = 0
    if left:
        while a < n:
            var d = _cp_at(bs, a)
            if not py_is_space(d[0]):
                break
            a += d[1]
    var b = n
    while b > a:
        var j = b - 1
        while j > a and (Int(bs[j]) & 0xC0) == 0x80:
            j -= 1
        var d = _cp_at(bs, j)
        if not py_is_space(d[0]):
            break
        b = j
    return (a, b)


def py_strip(s: String) -> String:
    """str.strip()."""
    var ab = _strip_bounds(s, True)
    return String(unsafe_from_utf8=s.as_bytes()[ab[0]:ab[1]])


def py_rstrip(s: String) -> String:
    """str.rstrip()."""
    var ab = _strip_bounds(s, False)
    return String(unsafe_from_utf8=s.as_bytes()[0:ab[1]])


def universal_newlines(s: String) -> String:
    """CRLF and lone CR become LF, as Python's text-mode reads do."""
    var bs = s.as_bytes()
    var n = len(bs)
    var has_cr = False
    for i in range(n):
        if Int(bs[i]) == 0x0D:
            has_cr = True
            break
    if not has_cr:
        return s
    var out = List[UInt8](capacity=n)
    var i = 0
    while i < n:
        var c = Int(bs[i])
        if c == 0x0D:
            out.append(0x0A)
            if i + 1 < n and Int(bs[i + 1]) == 0x0A:
                i += 1
        else:
            out.append(bs[i])
        i += 1
    return _finish(out)


# ---------------------------------------------------------------------------
# xml.sax.saxutils
# ---------------------------------------------------------------------------
def _xml_escape_into(mut out: List[UInt8], s: String, attr: Bool):
    var bs = s.as_bytes()
    for i in range(len(bs)):
        var c = Int(bs[i])
        if c == 0x26:
            _put_str(out, "&amp;")
        elif c == 0x3C:
            _put_str(out, "&lt;")
        elif c == 0x3E:
            _put_str(out, "&gt;")
        elif attr and c == 0x0A:
            _put_str(out, "&#10;")
        elif attr and c == 0x0D:
            _put_str(out, "&#13;")
        elif attr and c == 0x09:
            _put_str(out, "&#9;")
        else:
            out.append(bs[i])


def xml_escape(s: String) -> String:
    """xml.sax.saxutils.escape(s): & < >."""
    var out = List[UInt8](capacity=s.byte_length())
    _xml_escape_into(out, s, False)
    return _finish(out)


def xml_quoteattr(s: String) -> String:
    """xml.sax.saxutils.quoteattr(s)."""
    var body = List[UInt8](capacity=s.byte_length() + 2)
    _xml_escape_into(body, s, True)
    var has_dq = False
    var has_sq = False
    for i in range(len(body)):
        if Int(body[i]) == 0x22:
            has_dq = True
        elif Int(body[i]) == 0x27:
            has_sq = True
    var out = List[UInt8](capacity=len(body) + 8)
    if has_dq and has_sq:
        out.append(0x22)
        for i in range(len(body)):
            if Int(body[i]) == 0x22:
                _put_str(out, "&quot;")
            else:
                out.append(body[i])
        out.append(0x22)
    elif has_dq:
        out.append(0x27)
        _put_bytes(out, Span(body), 0, len(body))
        out.append(0x27)
    else:
        out.append(0x22)
        _put_bytes(out, Span(body), 0, len(body))
        out.append(0x22)
    return _finish(out)


# ---------------------------------------------------------------------------
# Non-printable ranges of Python 3.12 (Unicode 15.0.0), code points >= U+0080.
# Records "SSSSSSEEEEEE" (hex, inclusive), 13 bytes apart. Generated by
# agents/mojo/tests/golden/gen_pyfmt.py --table; do not edit by hand.
# ---------------------------------------------------------------------------
comptime _NONPRINTABLE = """0000800000a0 0000ad0000ad 000378000379 000380000383 00038b00038b 00038d00038d 0003a20003a2 000530000530
000557000558 00058b00058c 000590000590 0005c80005cf 0005eb0005ee 0005f5000605 00061c00061c 0006dd0006dd
00070e00070f 00074b00074c 0007b20007bf 0007fb0007fc 00082e00082f 00083f00083f 00085c00085d 00085f00085f
00086b00086f 00088f000897 0008e20008e2 000984000984 00098d00098e 000991000992 0009a90009a9 0009b10009b1
0009b30009b5 0009ba0009bb 0009c50009c6 0009c90009ca 0009cf0009d6 0009d80009db 0009de0009de 0009e40009e5
0009ff000a00 000a04000a04 000a0b000a0e 000a11000a12 000a29000a29 000a31000a31 000a34000a34 000a37000a37
000a3a000a3b 000a3d000a3d 000a43000a46 000a49000a4a 000a4e000a50 000a52000a58 000a5d000a5d 000a5f000a65
000a77000a80 000a84000a84 000a8e000a8e 000a92000a92 000aa9000aa9 000ab1000ab1 000ab4000ab4 000aba000abb
000ac6000ac6 000aca000aca 000ace000acf 000ad1000adf 000ae4000ae5 000af2000af8 000b00000b00 000b04000b04
000b0d000b0e 000b11000b12 000b29000b29 000b31000b31 000b34000b34 000b3a000b3b 000b45000b46 000b49000b4a
000b4e000b54 000b58000b5b 000b5e000b5e 000b64000b65 000b78000b81 000b84000b84 000b8b000b8d 000b91000b91
000b96000b98 000b9b000b9b 000b9d000b9d 000ba0000ba2 000ba5000ba7 000bab000bad 000bba000bbd 000bc3000bc5
000bc9000bc9 000bce000bcf 000bd1000bd6 000bd8000be5 000bfb000bff 000c0d000c0d 000c11000c11 000c29000c29
000c3a000c3b 000c45000c45 000c49000c49 000c4e000c54 000c57000c57 000c5b000c5c 000c5e000c5f 000c64000c65
