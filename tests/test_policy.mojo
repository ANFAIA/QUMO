# Tests for qumo.compiler.policy / policy_synth (learned-policy inference and
# policy-guided synthesis). Fixture models: tests/fixtures/ai/policy (random
# weights, generated by training/ai_transpiler/common/make_fixtures.py), so
# these tests never depend on trained models; trained models under
# models/ai_transpiler/synth are checked too when present.
from std.os.path import exists
from std.testing import assert_true, assert_equal
from qumo.ir.circuit import Instruction
from qumo.ir.gates import Op
from qumo.ai.json import parse_json, JsonValue
from qumo.sim.rng import Rng
from qumo.compiler.blockalg import (
    SubGraph, BlockKind, Perm, GF2Mat, SympTab, PauliNet, dense_equiv,
)
from qumo.compiler.policy import (
    load_model_file, model_search_dirs, MLPPolicy, ModelFile, find_model, read_model_index,
    wl_hash, f16_to_f32, graph_embedding,
)
from qumo.compiler.policy_synth import (
    PolicyEnv, PolicySession, greedy_trace, policy_available,
    policy_synth_perm, policy_synth_linear, policy_synth_clifford, policy_synth_pauli_network,
)

comptime FX = "tests/fixtures/ai/policy"


def _ints(v: JsonValue) raises -> List[Int]:
    var out = List[Int]()
    for i in range(len(v)):
        out.append(v.at(i).as_int())
    return out^


def _dirs() -> List[String]:
    var d = List[String]()
    d.append(FX)
    return d^


def check_model_parity(dir: String) raises -> Float64:
    """Forward parity (identity + ensemble) vs the manifest test vectors and
    greedy-trace parity vs the manifest rollouts. Returns the worst |diff|."""
    var m = load_model_file(dir)
    var pol = MLPPolicy.from_model(m)
    var man = parse_json(m.manifest)
    var tv = man.get("test_vectors")
    assert_true(len(tv) > 0)
    var worst: Float64 = 0.0
    for t in range(len(tv)):
        var obs = _ints(tv.at(t).get("obs"))
        var lg = List[Float32]()
        var v = pol.forward(obs, lg)
        var rl = tv.at(t).get("logits")
        assert_equal(len(lg), len(rl))
        for a in range(len(lg)):
            worst = max(worst, abs(Float64(lg[a]) - rl.at(a).as_float()))
        worst = max(worst, abs(Float64(v) - tv.at(t).get("value").as_float()))
        var le = List[Float32]()
        var ve = pol.forward_ensemble(obs, le)
        var re = tv.at(t).get("logits_ensemble")
        for a in range(len(le)):
            worst = max(worst, abs(Float64(le[a]) - re.at(a).as_float()))
        worst = max(worst, abs(Float64(ve) - tv.at(t).get("value_ensemble").as_float()))
    assert_true(worst <= 1e-5, "forward parity " + String(worst) + " for " + dir)
    var ro = man.get("rollouts")
    for r in range(len(ro)):
        var ij = ro.at(r).get("input")
        var st = List[UInt64]()
        for j in range(len(ij)):
            st.append(UInt64(ij.at(j).as_int()))
        var env = PolicyEnv(m.kind_code, m.num_qubits, m)
        if m.kind_code == BlockKind.PAULI:
            env.init_pauli(ro.at(r).get("R").as_int(), st)
        var ok = False
        var acts = greedy_trace(env, pol, m.max_depth, st, ok)
        var want = _ints(ro.at(r).get("actions"))
        assert_equal(len(acts), len(want), "rollout length " + dir)
        for j in range(len(acts)):
            assert_equal(acts[j], want[j], "rollout action " + dir)
        if ro.at(r).has("solved"):
            assert_equal(ok, ro.at(r).get("solved").as_bool())
    return worst


def test_loader_and_parity() raises:
    var ids: List[String] = ["fx_perm_line3", "fx_perm_star4", "fx_lf_line3", "fx_cliff_line2", "fx_pauli_line3"]
    for id in ids:
        _ = check_model_parity(String(FX) + "/synth/" + id)
    var m = load_model_file(String(FX) + "/synth/fx_perm_star4")
    assert_equal(m.kind, "permutation")
    assert_equal(m.num_qubits, 4)
    assert_equal(m.num_actions(), 3)
    assert_equal(len(m.obs_perms), 6)  # star:4 has 3! automorphisms
    assert_true(abs(Float64(f16_to_f32(0x3C00)) - 1.0) < 1e-12)
    assert_true(abs(Float64(f16_to_f32(0x0001)) - 5.960464477539063e-08) < 1e-15)
    # corruption -> QM-E617
    var bad: List[String] = ["bad_checksum", "bad_format", "does_not_exist"]
    for b in bad:
        var raised = False
        try:
            _ = load_model_file(String(FX) + "/" + b)
        except e:
            raised = String(e).startswith("QM-E617")
        assert_true(raised, "expected QM-E617 for " + b)
    print("  loader / checksum / forward + rollout parity OK")


def test_trained_models() raises:
    """Parity for every committed trained model (skipped when absent)."""
    var root = "models/ai_transpiler"
    var rows = read_model_index(root, "synth")
    var worst: Float64 = 0.0
    var dirs = List[String]()
    dirs.append(root)
    var sess = PolicySession(dirs)
    var rng = Rng(99)
    var verified = 0
    for r in rows:
        worst = max(worst, check_model_parity(r.path))
        # exact, on-edge proposals on the model's own graph (explicit model id)
        var n = r.num_qubits
        var g = SubGraph(n, r.edges)
        for _ in range(2):
            var src = List[Instruction]()
            if r.kind_code == BlockKind.PERM:
                var p = Perm(_rand_perm(n, rng))
                var ops = sess.synth_perm(p, g, r.id, 4, 0, 1)
                if len(ops) > 0:
                    assert_true(Perm.from_ops(ops, n) == p)
                    verified += 1
                continue
            if r.kind_code == BlockKind.LINEAR:
                for _ in range(3 * n * n):
                    var a = rng.below(n)
                    var b = rng.below(n - 1)
                    if b >= a:
                        b += 1
                    src.append(Instruction.make(Op.CX, a, b))
                var m = GF2Mat.from_ops(src, n)
                var ops = sess.synth_linear(m, g, r.id, 4, 0, 1)
                if len(ops) > 0:
                    assert_true(GF2Mat.from_ops(ops, n) == m)
                    verified += 1
                continue
            src = _rand_cliff_ops(n, SubGraph.complete(n), 4 * n * n, rng)
            if r.kind_code == BlockKind.CLIFFORD:
                var t = SympTab.from_ops(src, n)
                var ops = sess.synth_clifford(t, g, r.id, 4, 0, 1)
                if len(ops) > 0:
                    assert_true(SympTab.from_ops(ops, n) == t)
                    verified += 1
                continue
            src.append(Instruction.make(Op.RZ, rng.below(n), -1, -1, 0.4))
            var more = _rand_cliff_ops(n, SubGraph.complete(n), 2 * n, rng)
            for o in more:
                src.append(o)
            src.append(Instruction.make(Op.RX, rng.below(n), -1, -1, 1.3))
            var pn = PauliNet.from_ops(src, n)
            var ops = sess.synth_pauli_network(pn, g, r.id, 4, 0, 1, src)
            if len(ops) > 0:
                var ph: Float64 = 0.0
                assert_true(dense_equiv(src, ops, n, ph))
                verified += 1
    print("  trained models checked:", len(rows), "worst parity", worst, "proposals verified", verified)


def test_find_model() raises:
    var dirs = _dirs()
    # WL hash agrees with the Python exporter (training/ai_transpiler/common/topology.py)
    assert_equal(wl_hash(3, [0, 1, 1, 2]), "30f7d5bfb0487582")
    # exact isomorphism: path 0-1-2
    var line3 = SubGraph(3, [0, 1, 1, 2])
    var mm = find_model(BlockKind.PERM, line3, "auto", dirs)
    assert_true(mm.ok and mm.exact)
    assert_equal(mm.id, "fx_perm_line3")
    # relabelled path 1-0-2 (centre 0): model centre 1 -> block 0
    var path = SubGraph(3, [0, 1, 0, 2])
    mm = find_model(BlockKind.PERM, path, "auto", dirs)
    assert_true(mm.ok)
    assert_equal(mm.perm[1], 0)
    # monomorphism: the path embeds in the triangle
    var tri = SubGraph.complete(3)
    mm = find_model(BlockKind.PERM, tri, "auto", dirs)
    assert_true(mm.ok and not mm.exact)
    for e in range(2):
        var a = mm.perm[e]
        var b = mm.perm[e + 1]
        assert_true(tri.has_edge(min(a, b), max(a, b)))
    # star:4 with centre 2 -> model centre 0 maps to 2
    var star = SubGraph(4, [0, 2, 1, 2, 2, 3])
    mm = find_model(BlockKind.PERM, star, "auto", dirs)
    assert_true(mm.ok and mm.exact)
    assert_equal(mm.id, "fx_perm_star4")
    assert_equal(mm.perm[0], 2)
    # a 4-path does not contain a star
    assert_true(not find_model(BlockKind.PERM, SubGraph(4, [0, 1, 1, 2, 2, 3]), "auto", dirs).ok)
    # explicit id, off, wrong kind, wrong size
    assert_true(find_model(BlockKind.PERM, line3, "fx_perm_line3", dirs).ok)
    assert_true(not find_model(BlockKind.PERM, line3, "off", dirs).ok)
    assert_true(not find_model(BlockKind.PERM, line3, "nope", dirs).ok)
    assert_true(not find_model(BlockKind.CLIFFORD, line3, "auto", dirs).ok)
    assert_true(policy_available(BlockKind.LINEAR, line3, "auto", dirs))
    var s = PolicySession(dirs)
    var raised = False
    try:
        _ = s.match(BlockKind.PERM, line3, "nope")
    except e:
        raised = String(e).startswith("QM-E616")
    assert_true(raised)
    # matcher on a disconnected model graph inside a connected one
    var phi = List[Int]()
    assert_true(graph_embedding(4, [0, 1, 2, 3], [0, 1, 1, 2, 2, 3], phi))
    print("  find_model iso / mono / perm OK")


def _rand_perm(n: Int, mut rng: Rng) -> List[Int]:
    var p = List[Int]()
    for i in range(n):
        p.append(i)
    for i in range(n - 1, 0, -1):
        var j = rng.below(i + 1)
        var t = p[i]
        p[i] = p[j]
        p[j] = t
    return p^


def _rand_cliff_ops(n: Int, g: SubGraph, depth: Int, mut rng: Rng) -> List[Instruction]:
    var ops = List[Instruction]()
    for _ in range(depth):
        var r = rng.below(4)
        if r == 0:
            ops.append(Instruction.make(Op.H, rng.below(n)))
        elif r == 1:
            ops.append(Instruction.make(Op.S, rng.below(n)))
        elif r == 2:
            ops.append(Instruction.make(Op.X, rng.below(n)))
        else:
            var e = rng.below(g.num_edges())
            ops.append(Instruction.make(Op.CX, g.edges[2 * e], g.edges[2 * e + 1]))
    return ops^


def test_policy_synthesis() raises:
    """Outputs of every kind are exact (recomputed with blockalg) and on edges."""
    var dirs = _dirs()
    var rng = Rng(11)
    var found = 0
    var sess = PolicySession(dirs)
    # permutations on a 4-star (block centre = 1)
    var star = SubGraph(4, [0, 1, 1, 2, 1, 3])
    for _ in range(6):
        var p = Perm(_rand_perm(4, rng))
        var ops = sess.synth_perm(p, star, "auto", 4, 2, 5)
        if len(ops) > 0 or p.is_identity():
            found += 1
            assert_true(Perm.from_ops(ops, 4) == p)
            for o in ops:
                assert_true(star.has_edge(min(o.q0, o.q1), max(o.q0, o.q1)))
    # linear functions on a path 2-0-1
    var path = SubGraph(3, [0, 1, 0, 2])
    for _ in range(4):
        var src = List[Instruction]()
        for _ in range(6):
            var e = rng.below(2)
            var a = path.edges[2 * e]
            var b = path.edges[2 * e + 1]
            if rng.below(2) == 0:
                src.append(Instruction.make(Op.CX, a, b))
            else:
                src.append(Instruction.make(Op.CX, b, a))
        var m = GF2Mat.from_ops(src, 3)
        var ops = sess.synth_linear(m, path, "auto", 8, 4, 3)
        if len(ops) > 0:
            found += 1
            assert_true(GF2Mat.from_ops(ops, 3) == m)
    # Cliffords on 2 qubits (random fixture policy, beam + samples)
    var two = SubGraph(2, [0, 1])
    for _ in range(4):
        var src = _rand_cliff_ops(2, two, 12, rng)
        var t = SympTab.from_ops(src, 2)
        var ops = sess.synth_clifford(t, two, "auto", 8, 8, 9)
        if len(ops) > 0:
            found += 1
            assert_true(SympTab.from_ops(ops, 2) == t)
            var ph: Float64 = 0.0
            assert_true(dense_equiv(src, ops, 2, ph))
    # Pauli networks on a 3-path: Clifford gates + rotations
    var line3 = SubGraph(3, [0, 1, 1, 2])
    for _ in range(4):
        var src = _rand_cliff_ops(3, line3, 8, rng)
        src.append(Instruction.make(Op.RZ, rng.below(3), -1, -1, 0.37))
        var more = _rand_cliff_ops(3, line3, 6, rng)
        for o in more:
            src.append(o)
        src.append(Instruction.make(Op.RX, rng.below(3), -1, -1, -1.1))
        var pn = PauliNet.from_ops(src, 3)
        var ops = sess.synth_pauli_network(pn, line3, "auto", 8, 8, 4, src)
        if len(ops) > 0:
            found += 1
            var ph: Float64 = 0.0
            assert_true(dense_equiv(src, ops, 3, ph), "pauli network not equivalent")
            for o in ops:
                if o.kind == Op.CX:
                    assert_true(line3.has_edge(min(o.q0, o.q1), max(o.q0, o.q1)))
    assert_true(found >= 6, "too few policy proposals: " + String(found))
    print("  policy synthesis exact (", found, "proposals verified )")


def test_determinism() raises:
    var dirs = _dirs()
    var star = SubGraph(4, [0, 1, 1, 2, 1, 3])
    var p: List[Int] = [3, 2, 0, 1]
    var a = policy_synth_perm(Perm(p), star, "auto", 4, 3, 17, dirs)
    var b = policy_synth_perm(Perm(p), star, "auto", 4, 3, 17, dirs)
    assert_equal(len(a), len(b))
    for i in range(len(a)):
        assert_true(a[i].kind == b[i].kind and a[i].q0 == b[i].q0 and a[i].q1 == b[i].q1)
    var r3 = Rng(3)
    var src = _rand_cliff_ops(2, SubGraph(2, [0, 1]), 10, r3)
    var t = SympTab.from_ops(src, 2)
    var c1 = policy_synth_clifford(t, SubGraph(2, [0, 1]), "auto", 2, 5, 21, dirs)
    var c2 = policy_synth_clifford(t, SubGraph(2, [0, 1]), "auto", 2, 5, 21, dirs)
    assert_equal(len(c1), len(c2))
    for i in range(len(c1)):
        assert_true(c1[i].kind == c2[i].kind and c1[i].q0 == c2[i].q0 and c1[i].q1 == c2[i].q1)
    # model=off never proposes; an unknown explicit model raises QM-E616
    assert_equal(len(policy_synth_perm(Perm(p), star, "off", 4, 3, 17, dirs)), 0)
    var raised = False
    try:
        _ = policy_synth_linear(GF2Mat.identity(4), star, "missing_model", 4, 0, 1, dirs)
    except e:
        raised = String(e).startswith("QM-E616")
    assert_true(raised)
    print("  determinism / off / QM-E616 OK")


def main() raises:
    test_loader_and_parity()
    test_find_model()
    test_policy_synthesis()
    test_determinism()
    test_trained_models()
    print("test_policy OK")
