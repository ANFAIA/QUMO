"""Hardware characterization & noise modelling (Qibocal / Cirq-experiments style).

  * `NoiseModel` from calibration data (T1, T2, gate times, 1q/2q gate errors,
    readout errors) and `apply_noise_model(circuit, model)`, which inserts
    Pauli-twirled channels so the result runs on the stabilizer / frame
    simulators (and the state-vector trajectories):
      - idle / gate-duration relaxation: twirled amplitude+phase damping
            px = py = (1 - e^{-t/T1}) / 4
            pz      = (1 - e^{-t/T2}) / 2 - px
      - gate error e (average gate infidelity, e.g. from RB) beyond the
        relaxation already accounted for: DEPOLARIZE1(3/2 e1') after 1q
        gates, DEPOLARIZE2(5/4 e2') after 2q gates (Qiskit's
        `NoiseModel.from_backend` convention of not double counting T1/T2).
      - readout: X_ERROR((p01 + p10)/2) before each measurement (a Pauli
        channel cannot be asymmetric; use `ReadoutCalibration` +
        `mitigate_counts` for the asymmetric part).
    Idle noise uses ASAP scheduling: a qubit that waits for others before a
    gate gets the relaxation channel for its idle time.
  * Single-qubit randomized benchmarking: random sequences of the 24-element
    Clifford group (generated by H and S), an inverting Clifford, simulated
    with the bit-packed frame sampler; `fit_rb_decay` fits A p^m + B and
    reports error per Clifford r = (1 - p)/2.
  * Readout-error mitigation: per-qubit 2x2 confusion matrices calibrated
    from |0...0> / |1...1> runs, tensored inverse applied to counts.
  * T1 and Ramsey (T2*) experiment generators over the idle-noise model,
    with a robust exponential fit (variable projection: grid + golden
    section over the rate, linear least squares for amplitude/offset).

Error codes: QM-E709 (invalid calibration / noise model), QM-E710 (fit failure).
"""

from std.math import exp, log, sqrt
from std.collections import Dict

from qumo.ir.gates import Op, op_arity, op_is_unitary, op_is_noise, op_is_annotation
from qumo.ir.circuit import Circuit, Instruction
from qumo.sim.rng import Rng
from qumo.sim.frame import FrameSimulator


# ---------------------------------------------------------------------------
# Noise model
# ---------------------------------------------------------------------------
@fieldwise_init
struct PauliProbs(ImplicitlyCopyable, Writable):
    var px: Float64
    var py: Float64
    var pz: Float64

    def total(self) -> Float64:
        return self.px + self.py + self.pz

    def write_to(self, mut w: Some[Writer]):
        w.write("PauliProbs(px=", self.px, ", py=", self.py, ", pz=", self.pz, ")")


def thermal_pauli_channel(t: Float64, t1: Float64, t2: Float64) -> PauliProbs:
    """Pauli twirl of amplitude + phase damping for duration t (same units as T1/T2).

    T1 <= 0 or T2 <= 0 means "infinite" (no decay in that channel).
    """
    if t <= 0.0:
        return PauliProbs(0.0, 0.0, 0.0)
    var a = 0.0 if t1 <= 0.0 else 1.0 - exp(-t / t1)
    var b = 0.0 if t2 <= 0.0 else 1.0 - exp(-t / t2)
    var pxy = a / 4.0
    var pz = max(0.0, b / 2.0 - pxy)
    return PauliProbs(pxy, pxy, pz)


struct NoiseModel(Copyable, Writable):
    """Per-qubit calibration data -> circuit-level Pauli noise.

    Units: any consistent time unit (e.g. microseconds) for T1, T2 and the
    gate/measurement durations.
    """

    var num_qubits: Int
    var t1: List[Float64]
    var t2: List[Float64]
    var readout_p01: List[Float64]  # P(read 1 | prepared 0)
    var readout_p10: List[Float64]  # P(read 0 | prepared 1)
    var gate_error_1q: List[Float64]  # average gate infidelity
    var gate_error_2q: Float64
    var time_1q: Float64
    var time_2q: Float64
    var time_measure: Float64
    var time_reset: Float64
    var idle_noise: Bool

    def __init__(out self, num_qubits: Int):
        self.num_qubits = num_qubits
        self.t1 = List[Float64](length=num_qubits, fill=0.0)
        self.t2 = List[Float64](length=num_qubits, fill=0.0)
        self.readout_p01 = List[Float64](length=num_qubits, fill=0.0)
        self.readout_p10 = List[Float64](length=num_qubits, fill=0.0)
        self.gate_error_1q = List[Float64](length=num_qubits, fill=0.0)
        self.gate_error_2q = 0.0
        self.time_1q = 0.0
        self.time_2q = 0.0
        self.time_measure = 0.0
        self.time_reset = 0.0
        self.idle_noise = True

    @staticmethod
    def uniform(num_qubits: Int, t1: Float64, t2: Float64, error_1q: Float64, error_2q: Float64,
                readout_error: Float64, time_1q: Float64, time_2q: Float64,
                time_measure: Float64) raises -> NoiseModel:
        """Same calibration for every qubit (typical superconducting numbers:
        T1=100, T2=80 (us), e1=2e-4, e2=5e-3, readout=1e-2, t1q=0.035, t2q=0.3, tm=1.0)."""
        var m = NoiseModel(num_qubits)
        for q in range(num_qubits):
            m.t1[q] = t1
            m.t2[q] = t2
            m.readout_p01[q] = readout_error
            m.readout_p10[q] = readout_error
            m.gate_error_1q[q] = error_1q
        m.gate_error_2q = error_2q
        m.time_1q = time_1q
        m.time_2q = time_2q
        m.time_measure = time_measure
        m.time_reset = time_measure
        m.validate()
        return m^

    def validate(self) raises:
        for q in range(self.num_qubits):
            if self.t1[q] > 0.0 and self.t2[q] > 2.0 * self.t1[q] + 1e-12:
                raise Error("QM-E709: qubit " + String(q) + " has T2=" + String(self.t2[q]) + " > 2*T1=" + String(2.0 * self.t1[q]) + " (unphysical). Hint: T2 <= 2 T1 always holds; check units.")
            var probs: List[Float64] = [self.readout_p01[q], self.readout_p10[q], self.gate_error_1q[q]]
            for v in probs:
                if v < 0.0 or v > 0.5:
                    raise Error("QM-E709: qubit " + String(q) + " has an error probability " + String(v) + " outside [0, 0.5]. Hint: readout/gate errors are probabilities, e.g. 0.01.")
        if self.gate_error_2q < 0.0 or self.gate_error_2q > 0.75:
            raise Error("QM-E709: 2-qubit gate error " + String(self.gate_error_2q) + " outside [0, 0.75].")

    def idle_channel(self, q: Int, t: Float64) -> PauliProbs:
        return thermal_pauli_channel(t, self.t1[q], self.t2[q])

    def depolarizing_1q(self, q: Int) -> Float64:
        """DEPOLARIZE1 probability for the part of the 1q error not explained by relaxation."""
        var th = self.idle_channel(q, self.time_1q)
        var e_th = 2.0 * th.total() / 3.0
        var e = max(0.0, self.gate_error_1q[q] - e_th)
        return min(0.75, 1.5 * e)

    def depolarizing_2q(self, a: Int, b: Int) -> Float64:
        var ta = self.idle_channel(a, self.time_2q).total()
        var tb = self.idle_channel(b, self.time_2q).total()
        var e_th = 0.8 * (1.0 - (1.0 - ta) * (1.0 - tb))
        var e = max(0.0, self.gate_error_2q - e_th)
        return min(15.0 / 16.0, 1.25 * e)

    def readout_flip(self, q: Int) -> Float64:
        return 0.5 * (self.readout_p01[q] + self.readout_p10[q])

    def write_to(self, mut w: Some[Writer]):
        w.write("NoiseModel(qubits=", self.num_qubits, ", e2q=", self.gate_error_2q, ", t1q=",
                self.time_1q, ", t2q=", self.time_2q, ", tmeas=", self.time_measure, ")")


def _add_pauli_channel(mut out: Circuit, ch: PauliProbs, q: Int):
    if ch.total() > 0.0:
        out.pauli_channel_1(ch.px, ch.py, ch.pz, q)


def apply_noise_model(circuit: Circuit, model: NoiseModel) raises -> Circuit:
    """Copy of `circuit` with the model's noise channels inserted (see module doc)."""
    model.validate()
    if circuit.num_qubits > model.num_qubits:
        raise Error("QM-E709: circuit has " + String(circuit.num_qubits) + " qubits but the noise model covers " + String(model.num_qubits) + ". Hint: NoiseModel.uniform(circuit.num_qubits, ...).")
    var out = circuit.empty_like()
    out.records = circuit.records.copy()
    out.num_measurements = 0
    out.num_detectors = circuit.num_detectors
    out.num_observables = circuit.num_observables
    var clock = List[Float64](length=circuit.num_qubits, fill=0.0)
    for g in circuit.ops:
        var k = g.kind
        if op_is_annotation(k) or op_is_noise(k):
            out.append(g)
            continue
        var a = op_arity(k)
        var dur: Float64
        if k == Op.MEASURE:
            dur = model.time_measure
        elif k == Op.RESET:
            dur = model.time_reset
        elif a == 1:
            dur = model.time_1q
        else:
            dur = model.time_2q
        var start = 0.0
        for j in range(a):
            start = max(start, clock[g.qubit(j)])
        if model.idle_noise:
            for j in range(a):
                var q = g.qubit(j)
                _add_pauli_channel(out, model.idle_channel(q, start - clock[q]), q)
        if k == Op.MEASURE:
            var pf = model.readout_flip(g.q0)
            if pf > 0.0:
                out.x_error(pf, g.q0)
            out.measure(g.q0, g.clbit)
            out.ops[len(out.ops) - 1].cond = g.cond
            out.ops[len(out.ops) - 1].cond_val = g.cond_val
            out.ops[len(out.ops) - 1].cond_reg = g.cond_reg
        else:
            out.append(g)
        if op_is_unitary(k) and k != Op.I:
            for j in range(a):
                _add_pauli_channel(out, model.idle_channel(g.qubit(j), dur), g.qubit(j))
            if a == 1:
                var p1 = model.depolarizing_1q(g.q0)
                if p1 > 0.0:
                    out.depolarize1(p1, g.q0)
            elif a == 2:
                var p2 = model.depolarizing_2q(g.q0, g.q1)
                if p2 > 0.0:
                    out.depolarize2(p2, g.q0, g.q1)
        for j in range(a):
            clock[g.qubit(j)] = start + dur
    out.num_measurements = circuit.num_measurements
    return out^


# ---------------------------------------------------------------------------
# Fitting
# ---------------------------------------------------------------------------
@fieldwise_init
struct DecayFit(ImplicitlyCopyable, Writable):
    """y = A * rate^x + B  (equivalently A exp(-x/tau) + B with tau = -1/ln rate)."""

    var a: Float64
    var rate: Float64
    var b: Float64
    var residual: Float64

    def tau(self) -> Float64:
        if self.rate <= 0.0 or self.rate >= 1.0:
            return 0.0
        return -1.0 / log(self.rate)

    def write_to(self, mut w: Some[Writer]):
        w.write("DecayFit(A=", self.a, ", rate=", self.rate, ", B=", self.b, ", tau=", self.tau(), ", rss=", self.residual, ")")


def _linfit_given_rate(xs: List[Float64], ys: List[Float64], rate: Float64, fixed_b: Float64, mut a: Float64, mut b: Float64) -> Float64:
    """Least squares for A (and B unless fixed_b >= 0) with y = A rate^x + B; returns RSS."""
    var n = len(xs)
    var sf = 0.0
    var sff = 0.0
    var sy = 0.0
    var sfy = 0.0
    for i in range(n):
        var f = exp(xs[i] * log(rate))
        sf += f
        sff += f * f
        sy += ys[i]
        sfy += f * ys[i]
    if fixed_b >= 0.0:
        b = fixed_b
        a = (sfy - b * sf) / max(sff, 1e-300)
    else:
        var det = Float64(n) * sff - sf * sf
        if abs(det) < 1e-300:
            a = 0.0
            b = sy / Float64(max(1, n))
        else:
            a = (Float64(n) * sfy - sf * sy) / det
            b = (sy - a * sf) / Float64(n)
    var rss = 0.0
    for i in range(n):
        var r = ys[i] - (a * exp(xs[i] * log(rate)) + b)
        rss += r * r
    return rss


def fit_decay(xs: List[Float64], ys: List[Float64], fixed_b: Float64 = -1.0) raises -> DecayFit:
    """Fit y = A r^x + B (0 < r < 1) by variable projection.

    A log-spaced grid over (1 - r) brackets the optimum, then golden-section
    search refines it; A and B are solved by linear least squares for each r.
    `fixed_b >= 0` pins the asymptote (e.g. 0.5 for 1-qubit RB).
    """
    if len(xs) != len(ys) or len(xs) < 3:
        raise Error("QM-E710: decay fit needs >= 3 (x, y) points of equal length (got " + String(len(xs)) + ", " + String(len(ys)) + "). Hint: use more sequence lengths / delays.")
    var a = 0.0
    var b = 0.0
    var best_u = -1.0
    var best_rss = 1e300
    var ngrid = 400
    var umin = 1e-7
    var umax = 0.999
    for i in range(ngrid):
        var u = exp(log(umin) + (log(umax) - log(umin)) * Float64(i) / Float64(ngrid - 1))
        var rss = _linfit_given_rate(xs, ys, 1.0 - u, fixed_b, a, b)
        if rss < best_rss:
            best_rss = rss
            best_u = u
    # golden section on log(u) around the best grid point
    var step = (log(umax) - log(umin)) / Float64(ngrid - 1)
    var lo = log(best_u) - step
    var hi = log(best_u) + step
    var gr = 0.6180339887498949
    for _ in range(80):
        var m1 = hi - gr * (hi - lo)
        var m2 = lo + gr * (hi - lo)
        var r1 = _linfit_given_rate(xs, ys, 1.0 - exp(m1), fixed_b, a, b)
        var r2 = _linfit_given_rate(xs, ys, 1.0 - exp(m2), fixed_b, a, b)
        if r1 < r2:
            hi = m2
        else:
            lo = m1
    var u = exp(0.5 * (lo + hi))
    var rss = _linfit_given_rate(xs, ys, 1.0 - u, fixed_b, a, b)
    return DecayFit(a, 1.0 - u, b, rss)


def fit_exponential_decay(ts: List[Float64], ys: List[Float64]) raises -> DecayFit:
    """Fit y = A exp(-t / tau) + B; read tau via `.tau()` (same units as ts)."""
    return fit_decay(ts, ys)


# ---------------------------------------------------------------------------
# 1-qubit Clifford group and randomized benchmarking
# ---------------------------------------------------------------------------
def _conj_h(p: Int, s: Int) -> Tuple[Int, Int]:
    """H P H for P in {1:X, 2:Y, 3:Z} with sign s (+1/-1)."""
    if p == 1: return (3, s)
    if p == 3: return (1, s)
    return (2, -s)


def _conj_s(p: Int, s: Int) -> Tuple[Int, Int]:
    """S P S^dag: X -> Y, Y -> -X, Z -> Z."""
    if p == 1: return (2, s)
    if p == 2: return (1, -s)
    return (3, s)


struct Clifford1Q(Copyable, Writable):
    """A 1-qubit Clifford: images C X C^dag, C Z C^dag and a gate word (time order)."""

    var xp: Int
    var xs: Int
    var zp: Int
    var zs: Int
    var gates: List[Int]

    def __init__(out self):
        self.xp = 1
        self.xs = 1
        self.zp = 3
        self.zs = 1
        self.gates = List[Int]()

    def key(self) -> Int:
        return ((self.xp * 2 + (1 if self.xs > 0 else 0)) * 4 + self.zp) * 2 + (1 if self.zs > 0 else 0)

    def then(self, gate: Int) -> Clifford1Q:
        """This Clifford followed by gate (Op.H or Op.S)."""
        var c = Clifford1Q()
        var x: Tuple[Int, Int]
        var z: Tuple[Int, Int]
        if gate == Op.H:
            x = _conj_h(self.xp, self.xs)
            z = _conj_h(self.zp, self.zs)
        else:
            x = _conj_s(self.xp, self.xs)
            z = _conj_s(self.zp, self.zs)
        c.xp = x[0]
        c.xs = x[1]
        c.zp = z[0]
        c.zs = z[1]
        c.gates = self.gates.copy()
        c.gates.append(gate)
        return c^

    def write_to(self, mut w: Some[Writer]):
        w.write("Clifford1Q(X->", "+" if self.xs > 0 else "-", self.xp, ", Z->", "+" if self.zs > 0 else "-", self.zp, ", gates=", len(self.gates), ")")


def clifford_group_1q() -> List[Clifford1Q]:
    """The 24 single-qubit Cliffords (mod phase) as shortest H/S words (BFS)."""
    var out = List[Clifford1Q]()
    var seen = Dict[Int, Int]()
    out.append(Clifford1Q())
    seen[out[0].key()] = 0
    var head = 0
    while head < len(out):
        var gens: List[Int] = [Op.H, Op.S]
        for g in gens:
            var c = out[head].then(g)
            var k = c.key()
            if seen.get(k, -1) < 0:
                seen[k] = len(out)
                out.append(c^)
        head += 1
    return out^


def _apply_word(c: Clifford1Q, gates: List[Int]) -> Clifford1Q:
    var r = c.copy()
    for g in gates:
        r = r.then(g)
    return r^


def _inverse_index(group: List[Clifford1Q], total: Clifford1Q) -> Int:
    var ident = Clifford1Q().key()
    for i in range(len(group)):
        if _apply_word(total, group[i].gates).key() == ident:
            return i
    return -1


@fieldwise_init
struct RBResult(Copyable, Writable):
    var lengths: List[Float64]
    var survival: List[Float64]
    var fit: DecayFit
    var error_per_clifford: Float64
    var gates_per_clifford: Float64

    def error_per_gate(self) -> Float64:
        return self.error_per_clifford / max(self.gates_per_clifford, 1e-12)

    def write_to(self, mut w: Some[Writer]):
        w.write("RBResult(EPC=", self.error_per_clifford, ", EPG~", self.error_per_gate(), ", ", self.fit, ")")


def rb_sequence_circuit(length: Int, mut rng: Rng, group: List[Clifford1Q], depolarizing_per_clifford: Float64 = 0.0,
                        qubit: Int = 0, num_qubits: Int = 1) raises -> Circuit:
    """Random length-m Clifford sequence + inverse, measured into clbit 0.

    With `depolarizing_per_clifford > 0` a DEPOLARIZE1 is appended after every
    Clifford (the textbook RB model; EPC = 2/3 of that probability)."""
    var c = Circuit(max(num_qubits, qubit + 1), 1, "rb_m" + String(length))
    var total = Clifford1Q()
    for _ in range(length):
        var idx = rng.below(len(group))
        for gte in group[idx].gates:
            c.add(gte, qubit)
        total = _apply_word(total, group[idx].gates)
        if depolarizing_per_clifford > 0.0:
            c.depolarize1(depolarizing_per_clifford, qubit)
    var inv = _inverse_index(group, total)
    if inv < 0:
        raise Error("QM-E710: internal error: Clifford inverse not found.")
    for gte in group[inv].gates:
        c.add(gte, qubit)
    if depolarizing_per_clifford > 0.0:
        c.depolarize1(depolarizing_per_clifford, qubit)
    c.measure(qubit, 0)
    return c^


def survival_probability(circuit: Circuit, shots: Int, seed: UInt64) raises -> Float64:
    """Fraction of shots whose last measurement equals its noiseless value."""
    var fs = FrameSimulator(circuit)
    var ms = fs.sample_measurements(shots, seed)
    var m = circuit.num_measurements - 1
    var refbit = fs.prog.reference[m] != 0
    var same = 0
    for s in range(shots):
        if ms.get(s, m) == refbit:
            same += 1
    return Float64(same) / Float64(max(1, shots))


def randomized_benchmarking_1q(lengths: List[Int], num_sequences: Int, shots: Int, seed: UInt64 = 1,
                               depolarizing_per_clifford: Float64 = 0.0,
                               model: Optional[NoiseModel] = None) raises -> RBResult:
    """Standard 1-qubit RB: average survival over random sequences per length,
    fit A p^m + B, EPC = (1 - p) / 2.

    Noise: either the textbook per-Clifford depolarizing probability or a
    calibration `NoiseModel` applied gate by gate (or both)."""
    var group = clifford_group_1q()
    var rng = Rng(seed)
    var xs = List[Float64]()
    var ys = List[Float64]()
    var total_gates = 0
    for g in group:
        total_gates += len(g.gates)
    var seq_id = 0
    for m in lengths:
        var acc = 0.0
        for _ in range(num_sequences):
            var c = rb_sequence_circuit(m, rng, group, depolarizing_per_clifford)
            if model:
                c = apply_noise_model(c, model.value())
            acc += survival_probability(c, shots, seed + UInt64(1000 + seq_id))
            seq_id += 1
        xs.append(Float64(m))
        ys.append(acc / Float64(num_sequences))
    var fit = fit_decay(xs, ys)
    var epc = (1.0 - fit.rate) / 2.0
    return RBResult(xs^, ys^, fit, epc, Float64(total_gates) / Float64(len(group)))


# ---------------------------------------------------------------------------
# Readout error mitigation
# ---------------------------------------------------------------------------
struct ReadoutCalibration(Copyable, Writable):
    """Tensored readout model: A_q = [[1-p01, p10], [p01, 1-p10]] with
    A[i][j] = P(read i | prepared j)."""

    var num_qubits: Int
    var p01: List[Float64]
    var p10: List[Float64]

    def __init__(out self, num_qubits: Int):
        self.num_qubits = num_qubits
        self.p01 = List[Float64](length=num_qubits, fill=0.0)
        self.p10 = List[Float64](length=num_qubits, fill=0.0)

    @staticmethod
    def from_counts(num_qubits: Int, counts_all0: Dict[String, Int], counts_all1: Dict[String, Int]) raises -> ReadoutCalibration:
        """Estimate p01/p10 per qubit from the two calibration circuits."""
        var cal = ReadoutCalibration(num_qubits)
        var n0 = 0
        var n1 = 0
        var ones0 = List[Int](length=num_qubits, fill=0)
        var zeros1 = List[Int](length=num_qubits, fill=0)
        for kv in counts_all0.items():
            n0 += kv.value
            var bs = kv.key.as_bytes()
            var L = kv.key.byte_length()
            for q in range(min(num_qubits, L)):
                if Int(bs[L - 1 - q]) == ord("1"):
                    ones0[q] += kv.value
        for kv in counts_all1.items():
            n1 += kv.value
            var bs = kv.key.as_bytes()
            var L = kv.key.byte_length()
            for q in range(min(num_qubits, L)):
                if Int(bs[L - 1 - q]) == ord("0"):
                    zeros1[q] += kv.value
        if n0 == 0 or n1 == 0:
            raise Error("QM-E709: readout calibration needs non-empty counts for both |0..0> and |1..1>. Hint: run readout_calibration_circuits(n).")
        for q in range(num_qubits):
            cal.p01[q] = Float64(ones0[q]) / Float64(n0)
            cal.p10[q] = Float64(zeros1[q]) / Float64(n1)
        return cal^

    @staticmethod
    def from_model(model: NoiseModel) -> ReadoutCalibration:
        var cal = ReadoutCalibration(model.num_qubits)
        for q in range(model.num_qubits):
            cal.p01[q] = model.readout_p01[q]
            cal.p10[q] = model.readout_p10[q]
        return cal^

    def assignment_fidelity(self, q: Int) -> Float64:
        return 1.0 - 0.5 * (self.p01[q] + self.p10[q])

    def write_to(self, mut w: Some[Writer]):
        w.write("ReadoutCalibration(")
        for q in range(self.num_qubits):
            if q > 0:
                w.write(", ")
            w.write("q", q, ": p01=", self.p01[q], " p10=", self.p10[q])
        w.write(")")


def readout_calibration_circuits(num_qubits: Int) -> List[Circuit]:
    """[prepare |0..0> and measure all, prepare |1..1> and measure all]."""
    var out = List[Circuit]()
    var c0 = Circuit(num_qubits, num_qubits, "readout_cal_0")
    for q in range(num_qubits):
        c0.measure(q, q)
    var c1 = Circuit(num_qubits, num_qubits, "readout_cal_1")
    for q in range(num_qubits):
        c1.x(q)
    for q in range(num_qubits):
        c1.measure(q, q)
    out.append(c0^)
    out.append(c1^)
    return out^


def _bitstring(value: Int, width: Int) -> String:
    var s = String()
    var b = width - 1
    while b >= 0:
        s += "1" if (value >> b) & 1 == 1 else "0"
        b -= 1
    return s


def mitigate_counts(counts: Dict[String, Int], cal: ReadoutCalibration) raises -> Dict[String, Float64]:
    """Apply the tensored inverse confusion matrix to counts -> quasi-probabilities.

    Keys are Qiskit-style bitstrings (leftmost = highest clbit = qubit n-1).
    Works for n <= 24 bits (dense 2^n vector); entries below 1e-12 are dropped.
    """
    var n = cal.num_qubits
    if n > 24:
        raise Error("QM-E705: mitigate_counts() is dense in 2^n; n=" + String(n) + " > 24. Hint: mitigate marginals or expectation values instead.")
    var size = 1 << n
    var v = List[Float64](length=size, fill=0.0)
    var total = 0
    for kv in counts.items():
        var bs = kv.key.as_bytes()
        var L = kv.key.byte_length()
        var idx = 0
        for i in range(L):
            if Int(bs[i]) == ord("1"):
                var q = L - 1 - i
                if q < n:
                    idx |= 1 << q
        v[idx] += Float64(kv.value)
        total += kv.value
    if total == 0:
        raise Error("QM-E709: empty counts.")
    for i in range(size):
        v[i] /= Float64(total)
    for q in range(n):
        var a00 = 1.0 - cal.p01[q]
        var a01 = cal.p10[q]
        var a10 = cal.p01[q]
        var a11 = 1.0 - cal.p10[q]
        var det = a00 * a11 - a01 * a10
        if abs(det) < 1e-12:
            raise Error("QM-E709: confusion matrix of qubit " + String(q) + " is singular (p01 + p10 = 1). Hint: readout is uninformative; recalibrate.")
        var i00 = a11 / det
        var i01 = -a01 / det
        var i10 = -a10 / det
        var i11 = a00 / det
        var bit = 1 << q
        for i in range(size):
            if (i & bit) == 0:
                var x0 = v[i]
                var x1 = v[i | bit]
                v[i] = i00 * x0 + i01 * x1
                v[i | bit] = i10 * x0 + i11 * x1
    var out = Dict[String, Float64]()
    for i in range(size):
        if abs(v[i]) > 1e-12:
            out[_bitstring(i, n)] = v[i]
    return out^


def expectation_z(probs: Dict[String, Float64], qubits: List[Int]) -> Float64:
    """<Z_q1 Z_q2 ...> from (quasi-)probabilities keyed by bitstrings."""
    var e = 0.0
    for kv in probs.items():
        var bs = kv.key.as_bytes()
        var L = kv.key.byte_length()
        var parity = 0
        for q in qubits:
            if q < L and Int(bs[L - 1 - q]) == ord("1"):
                parity ^= 1
        e += -kv.value if parity == 1 else kv.value
    return e


# ---------------------------------------------------------------------------
# T1 / Ramsey
# ---------------------------------------------------------------------------
def t1_circuit(delay: Float64, model: NoiseModel, qubit: Int = 0) raises -> Circuit:
    """X, wait `delay` (twirled relaxation channel), measure (+ readout flip)."""
    var c = Circuit(model.num_qubits, 1, "t1")
    c.x(qubit)
    _add_pauli_channel(c, model.idle_channel(qubit, delay), qubit)
    var pf = model.readout_flip(qubit)
    if pf > 0.0:
        c.x_error(pf, qubit)
    c.measure(qubit, 0)
    return c^


def ramsey_circuit(delay: Float64, model: NoiseModel, qubit: Int = 0) raises -> Circuit:
    """H, wait `delay`, H, measure: P(0) = (1 + e^{-t/T2}) / 2 under the twirled model."""
    var c = Circuit(model.num_qubits, 1, "ramsey")
    c.h(qubit)
    _add_pauli_channel(c, model.idle_channel(qubit, delay), qubit)
    c.h(qubit)
    var pf = model.readout_flip(qubit)
    if pf > 0.0:
        c.x_error(pf, qubit)
    c.measure(qubit, 0)
    return c^


@fieldwise_init
struct CoherenceResult(Copyable, Writable):
    var delays: List[Float64]
    var populations: List[Float64]  # P(1) for T1, P(0) for Ramsey
    var fit: DecayFit

    def time_constant(self) -> Float64:
        return self.fit.tau()

    def write_to(self, mut w: Some[Writer]):
        w.write("CoherenceResult(tau=", self.time_constant(), ", ", self.fit, ")")


def _p_one(c: Circuit, shots: Int, seed: UInt64) raises -> Float64:
    var fs = FrameSimulator(c)
    var ms = fs.sample_measurements(shots, seed)
    return ms.fraction_one(0)


def t1_experiment(model: NoiseModel, delays: List[Float64], shots: Int, seed: UInt64 = 1, qubit: Int = 0) raises -> CoherenceResult:
    var ys = List[Float64]()
    for i in range(len(delays)):
        ys.append(_p_one(t1_circuit(delays[i], model, qubit), shots, seed + UInt64(i)))
    var fit = fit_exponential_decay(delays, ys)
    return CoherenceResult(delays.copy(), ys^, fit)


def ramsey_experiment(model: NoiseModel, delays: List[Float64], shots: Int, seed: UInt64 = 1, qubit: Int = 0) raises -> CoherenceResult:
    var ys = List[Float64]()
    for i in range(len(delays)):
        ys.append(1.0 - _p_one(ramsey_circuit(delays[i], model, qubit), shots, seed + UInt64(i)))
    var fit = fit_exponential_decay(delays, ys)
    return CoherenceResult(delays.copy(), ys^, fit)
